msgstr "Use == para uma correspondência exata. Aqui, LIKE é apenas uma correspondência de prefixo."

msgid "Use ==, >, >=, <, <=, BETWEEN … AND …, IN (…) or STARTS WITH."
msgstr "Use ==, >, >=, <, <=, BETWEEN … AND …, IN (…) ou STARTS WITH."

msgid "Value"
msgstr "Valor"

msgid "Vote"
msgstr "Voto"

msgid "Voting state"
msgstr "Estado de votação"

msgid "What the proof contains"
msgstr "O que a prova contém"

msgid "Which Platform SDK call backs each Radar page, with its arguments."
msgstr "Que chamada do SDK da Platform sustenta cada página do Radar, com os seus argumentos."

msgid "Write a literal prefix and one trailing %, as in LIKE 'abc%', or use STARTS WITH for a prefix that holds % or _."
msgstr "Escreva um prefixo literal e um % final, como em LIKE 'abc%', ou use STARTS WITH para um prefixo que contenha % ou _."

msgid "Write a query to run."
msgstr "Escreva uma consulta para executar."

msgid "Write text between single quotes, and write a quote inside the text twice."
msgstr "Escreva o texto entre aspas simples e escreva a aspa duas vezes dentro do texto."

msgid "Write text values, including IDs, in single quotes."
msgstr "Escreva valores de texto, incluindo IDs, entre aspas simples."

msgid "You can keep up to 20 queries here. Delete one first."
msgstr "Você pode guardar até 20 consultas aqui. Apague uma primeiro."

msgid "Your browser"
msgstr "O seu navegador"
