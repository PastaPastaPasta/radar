#. placeholder {0}: formatInt(budget.usedLastMinute)
#. placeholder {1}: formatInt(budget.capacity)
msgid "{0} of {1}"
msgstr "{0} de {1}"

msgid "{behind} blocks behind the tip"
msgstr "{behind} blocos atrás da ponta"

msgid "A second index for addresses, spent outputs, chainwork and governance"
msgstr "Um segundo índice para endereços, saídas gastas, chainwork e governança"

msgid "Asking Platform for its latest block…"
msgstr "A perguntar à Platform pelo seu último bloco…"

msgid "Best ChainLock"
msgstr "Melhor ChainLock"

#. placeholder {0}: formatPercent(chain.data.data.syncProgress, 1)
msgid "Catching up, {0}"
msgstr "A atualizar, {0}"

msgid "ChainLock block hash, reported by one node"
msgstr "Hash do bloco com ChainLock, informado por um nó"

msgid "ChainLock reported by one node"
msgstr "ChainLock comunicado por um só nó"

msgid "ChainLocked block hash"
msgstr "Hash do bloco ChainLocked"

msgid "Checking the sources…"
msgstr "A verificar as fontes…"

msgid "Core"
msgstr "Core"

msgid "Core addresses, mempool, governance and block lists"
msgstr "Endereços Core, mempool, governança e listas de blocos"

msgid "Core tip"
msgstr "Ponta do Core"

msgid "Core tip, blocks and transactions, straight from evonodes"
msgstr "Ponta do Core, blocos e transações, diretamente dos evonodes"

msgid "DAPI"
msgstr "DAPI"

msgid "DAPI and the Platform SDK are answering. Hosted sources are off in Decentralized only mode."
msgstr "DAPI e o SDK da Platform estão a responder. As fontes alojadas estão desativadas no modo «Apenas descentralizado»."

msgid "DAPI is busy, so block lists come from Hyphen while the budget recovers. Details still use DAPI."
msgstr "O DAPI está ocupado, por isso as listas de blocos vêm do Hyphen enquanto o orçamento recupera. Os detalhes continuam a usar o DAPI."

msgid "DAPI isn’t answering, so block and transaction details come from Hyphen and say so."
msgstr "O DAPI não responde, por isso os detalhes de blocos e transações vêm do Hyphen e isso é indicado."

msgid "DAPI request budget"
msgstr "Orçamento de pedidos ao DAPI"

msgid "Dash Core"
msgstr "Dash Core"

msgid "Decentralized only mode doesn’t contact this source."
msgstr "O modo «Apenas descentralizado» não contacta esta fonte."

msgid "Details"
msgstr "Detalhes"

msgid "Every source is answering."
msgstr "Todas as fontes respondem."

msgid "Everything Core shows comes from DAPI."
msgstr "Tudo o que o Core mostra vem do DAPI."

msgid "Figures computed on your device"
msgstr "Valores calculados no seu dispositivo"

msgid "Getting tight"
msgstr "A ficar apertado"

msgid "Headers and blocks"
msgstr "Cabeçalhos e blocos"

msgid "Headroom"
msgstr "Margem"

msgid "How each source is answering, and how far behind its data is."
msgstr "Como cada fonte responde e quanto os seus dados estão atrasados."

msgid "Hyphen"
msgstr "Hyphen"

msgid "Indexed to Core block {indexed} of {chain}. It calls its sync “{sync}”, but its index is behind the chain."
msgstr "Indexado até ao bloco {indexed} de {chain} do Core. O Hyphen diz que a sua sincronização está «{sync}», mas o índice está atrasado em relação à cadeia."

msgid "Indexed to Core block {indexed} of {chain}. Sync: {sync}."
msgstr "Indexado até ao bloco Core {indexed} de {chain}. Sincronização: {sync}."

msgid "Indexed to Platform block {indexed} of {chain}. Indexer: {state}."
msgstr "Indexado até ao bloco Platform {indexed} de {chain}. Indexador: {state}."

msgid "Insight"
msgstr "Insight"

msgid "It answered with an error."
msgstr "Respondeu com um erro."

msgid "It hasn’t answered yet."
msgstr "Ainda não respondeu."

msgid "It is rate limiting this browser."
msgstr "Está a limitar os pedidos deste navegador."

msgid "It sent an answer Radar can’t read."
msgstr "Enviou uma resposta que o Radar não consegue ler."

msgid "It took too long to answer."
msgstr "Demorou demasiado a responder."

msgid "Its data is behind."
msgstr "Os seus dados estão atrasados."

msgid "Its tip is Core block {tip}, behind the chain."
msgstr "A sua ponta é o bloco {tip} do Core, atrás da cadeia."

msgid "Its tip is Core block {tip}."
msgstr "A sua ponta é o bloco {tip} do Core."

#. placeholder {0}: formatRelative(clampSkew(finished, now), now)
#. placeholder {1}: formatInt(status.chain.blocks)
msgid "Last crawl finished {0}. Its Core node is at block {1}."
msgstr "O último rastreio terminou {0}. O seu nó Core está no bloco {1}."

#. placeholder {0}: ago(health.lastOkAt)
msgid "Last good {0}."
msgstr "Última resposta correta {0}."

msgid "Median answer {rounded} ms"
msgstr "Resposta mediana {rounded} ms"

msgid "Network internals: peers, mempool pressure, versions and history"
msgstr "Funcionamento interno da rede: pares, pressão do mempool, versões e histórico"

msgid "No crawl has finished yet."
msgstr "Ainda não terminou nenhum rastreio."

msgid "No DAPI requests have been made on this network yet."
msgstr "Ainda não foi feito nenhum pedido ao DAPI nesta rede."

msgid "Node sync"
msgstr "Sincronização do nó"

msgid "Nodes resting"
msgstr "Nós em repouso"

msgid "Not available right now"
msgstr "Indisponível de momento"

msgid "Not offered"
msgstr "Não oferecido"

msgid "Nothing has asked it yet on this network."
msgstr "Ninguém lhe perguntou ainda nesta rede."

msgid "Off in this mode"
msgstr "Desativado neste modo"

msgid "Platform Explorer"
msgstr "Platform Explorer"

msgid "Platform lists and counts"
msgstr "Listas e contagens da Platform"

msgid "Platform SDK"
msgstr "SDK da Platform"

msgid "Plenty of room"
msgstr "Muita margem"

msgid "Pressure"
msgstr "Pressão"

msgid "Price feed"
msgstr "Feed de preços"

msgid "Proof-checked at Platform block {block}, epoch {epoch}. That block is {age}."
msgstr "Verificado com provas no bloco {block} da Platform, época {epoch}. Esse bloco é de {age}."

msgid "Proof-checked Platform state, verified in this browser"
msgstr "Estado da Platform verificado com provas, confirmado neste navegador"

msgid "Radar crawler"
msgstr "Rastreador do Radar"

msgid "Radar keeps each evonode well under its rate limit, so one visitor can’t crowd out another."
msgstr "O Radar mantém cada evonode bem abaixo do seu limite de pedidos, para que um visitante não prejudique outro."

msgid "Requests in the last minute"
msgstr "Pedidos no último minuto"

msgid "Some requests are failing."
msgstr "Alguns pedidos estão a falhar."

msgid "Some sources are slow or behind. The rest still work."
msgstr "Algumas fontes estão lentas ou atrasadas. As restantes continuam a funcionar."

msgid "Some sources aren’t answering. The rest still work."
msgstr "Algumas fontes não respondem. As restantes continuam a funcionar."

msgid "Sources"
msgstr "Fontes"

msgid "Status"
msgstr "Estado"

msgid "Synced"
msgstr "Sincronizado"

msgid "The connection failed."
msgstr "A ligação falhou."

msgid "The masternode census and network history"
msgstr "O censo de masternodes e o histórico da rede"

msgid "The median answer takes {seconds} s."
msgstr "A resposta mediana demora {seconds} s."

msgid "The request budget is nearly used."
msgstr "O orçamento de pedidos está quase esgotado."

msgid "The USD rate, through Platform Explorer"
msgstr "A cotação em USD através do Platform Explorer"

msgid "This browser"
msgstr "Este navegador"

msgid "This network doesn’t have this source."
msgstr "Esta rede não tem esta fonte."

msgid "Tip hash"
msgstr "Hash da ponta"

msgid "Used up for now"
msgstr "Esgotado por agora"

msgid "What the evonodes report about the chain right now."
msgstr "O que os evonodes reportam neste momento sobre a cadeia."
