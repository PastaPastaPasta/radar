msgid "“{field}” has more than one clause. Use one, or a lower and an upper bound."
msgstr "“{field}” tem mais de uma cláusula. Use uma, ou um limite inferior e um superior."

msgid "“{field}” isn’t in any index of this type, so Platform can’t filter on it."
msgstr "“{field}” não está em nenhum índice deste tipo, então o Platform não pode filtrar por ele."

msgid "“{field}” needs a clause on “{other}” first: index {index} is read in order, earlier properties before later ones."
msgstr "“{field}” precisa antes de uma cláusula em “{other}”: o índice {index} é lido em ordem, as propriedades anteriores antes das posteriores."

msgid "“{field}” needs a value."
msgstr "“{field}” precisa de um valor."

msgid "“{field}” takes a whole number."
msgstr "“{field}” aceita um número inteiro."

msgid "“{field}” takes an identifier: 32 bytes written in base58."
msgstr "“{field}” aceita um identificador: 32 bytes escritos em base58."

msgid "“{field}” takes true or false."
msgstr "“{field}” aceita true ou false."

msgid "“starts with” works on text, and “{field}” isn’t text."
msgstr "“começa com” funciona com texto, e “{field}” não é texto."

msgid "{changeCount, plural, one {# change} other {# changes}}"
msgstr "{changeCount, plural, one {# mudança} other {# mudanças}}"

msgid "{count, plural, one {# signer} other {# signers}}"
msgstr "{count, plural, one {# signatário} other {# signatários}}"

msgid "{f}, ascending"
msgstr "{f}, crescente"

msgid "{f}, descending"
msgstr "{f}, decrescente"

msgid "{field}: searching “{searched}” for “{typed}” (DPNS stores o, i and l as 0, 1 and 1)"
msgstr "{field}: buscando “{searched}” para “{typed}” (o DPNS guarda o, i e l como 0, 1 e 1)"

msgid "{pinnedOrderField}, ascending"
msgstr "{pinnedOrderField}, crescente"

msgid "{pinnedOrderField}, descending"
msgstr "{pinnedOrderField}, decrescente"

msgid "{props} properties · {indices} indices"
msgstr "{props} propriedades · {indices} índices"

msgid "{signerCount}, power {signedPower} of {requiredPower} required"
msgstr "{signerCount}, peso {signedPower} de {requiredPower} necessário"

msgid "A contract can hold only tokens or groups."
msgstr "Um contrato só pode conter tokens ou grupos."

msgid "A contract ID"
msgstr "Um ID de contrato"

msgid "A contract ID is 44 base58 characters or fewer."
msgstr "Um ID de contrato tem no máximo 44 caracteres base58."

msgid "A group lists identities and the power each holds; a decision needs enough power to reach the group’s threshold."
msgstr "Um grupo lista identidades e o peso de cada uma; uma decisão precisa de peso suficiente para atingir o limite do grupo."

msgid "A query can have only one “in” clause."
msgstr "Uma consulta só pode ter uma cláusula “in”."

msgid "A range (<, ≤, >, ≥, starts with) on “{field}” must be on the last property you filter on in index {index}, but “{other}” comes after it."
msgstr "Um intervalo (<, ≤, >, ≥, começa com) em “{field}” deve estar na última propriedade filtrada do índice {index}, mas “{other}” vem depois."

