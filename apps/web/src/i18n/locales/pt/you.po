msgid "{count, plural, one {# DAPI address} other {# DAPI addresses}}"
msgstr "{count, plural, one {# endereço DAPI} many {# de endereços DAPI} other {# endereços DAPI}}"

msgid "Add a devnet"
msgstr "Adicionar uma devnet"

msgid "Add devnet"
msgstr "Adicionar devnet"

msgid "Amounts"
msgstr "Valores"

msgid "Amounts show in {unitName}."
msgstr "Os valores são mostrados em {unitName}."

msgid "Amounts show in {unitName}. Choose USD to lead with the dollar value."
msgstr "Os valores são mostrados em {unitName}. Escolha USD para pôr o valor em dólares primeiro."

msgid "Cancel"
msgstr "Cancelar"

msgid "Custom devnets"
msgstr "Devnets personalizadas"

msgid "DAPI addresses"
msgstr "Endereços DAPI"

msgid "Devnet name"
msgstr "Nome da devnet"

msgid "Edit"
msgstr "Editar"

msgid "Edit {editName}"
msgstr "Editar {editName}"

msgid "Enter at least one DAPI address as host:port, one per line."
msgstr "Introduza pelo menos um endereço DAPI como host:porta, um por linha."

msgid "Example"
msgstr "Exemplo"

msgid "Language"
msgstr "Idioma"

msgid "No devnets saved."
msgstr "Nenhuma devnet guardada."

msgid "Open"
msgstr "Abrir"

msgid "optional"
msgstr "opcional"

msgid "Otherwise times follow this device’s time zone. Hovering a time always shows UTC."
msgstr "Caso contrário, as horas seguem o fuso horário deste dispositivo. Ao pairar sobre uma hora, é sempre mostrado o UTC."

msgid "Quorum list URL"
msgstr "URL da lista de quóruns"

#. placeholder {0}: formatFiat(DUFFS_PER_DASH, rate.data.data.usd)
#. placeholder {1}: rate.data.data.provider
msgid "Rate: {0} per DASH, from {1}."
msgstr "Taxa: {0} por DASH, de {1}."

msgid "Remove"
msgstr "Remover"

msgid "Remove {devnet}"
msgstr "Remover {devnet}"

msgid "Save changes"
msgstr "Guardar alterações"

msgid "Saved devnets"
msgstr "Devnets guardadas"

msgid "Saved in this browser. A devnet with a name Radar doesn’t know asks for its addresses."
msgstr "Guardado neste navegador. Uma devnet com um nome que o Radar não conhece pede os seus endereços."

msgid "See every source"
msgstr "Ver todas as fontes"

msgid "Settings"
msgstr "Definições"

msgid "Show the USD value next to DASH amounts"
msgstr "Mostrar o valor em USD junto aos valores em DASH"

msgid "Show times in UTC"
msgstr "Mostrar as horas em UTC"

msgid "Sources"
msgstr "Fontes"

msgid "Test coins have no value, so Testnet and devnets never show USD."
msgstr "As moedas de teste não têm valor, por isso a testnet e as devnets nunca mostram USD."

msgid "Text that isn’t translated yet appears in English. Hashes, IDs and amounts are never translated."
msgstr "O texto que ainda não está traduzido aparece em inglês. Os hashes, os IDs e os valores nunca são traduzidos."

msgid "The quorum list URL must start with https://."
msgstr "O URL da lista de quóruns tem de começar por https://."

msgid "These choices stay in this browser. Radar never sends them anywhere."
msgstr "Estas opções ficam neste navegador. O Radar nunca as envia para lado nenhum."

msgid "Times"
msgstr "Horas"

msgid "Unit for amounts"
msgstr "Unidade dos valores"

msgid "USD comes first, with the DASH figure after it once the rate is in."
msgstr "USD vem primeiro e o valor em DASH vem depois, quando a taxa chega."

msgid "USD is for mainnet only: test coins have no value."
msgstr "USD só está disponível na mainnet: moedas de teste não têm valor."

msgid "USD is rounded to three significant figures and follows the amount in {unitName}."
msgstr "USD é arredondado a três algarismos significativos e acompanha o valor em {unitName}."

msgid "USD is rounded to three significant figures. This choice doesn’t apply while USD comes first."
msgstr "USD é arredondado a três algarismos significativos. Esta escolha não se aplica enquanto USD vem primeiro."

msgid "Use lowercase letters, digits and hyphens, for example \"ruby\"."
msgstr "Use letras minúsculas, dígitos e hífenes, por exemplo “ruby”."

msgid "You"
msgstr "Você"
