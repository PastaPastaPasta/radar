msgid "{count, plural, one {# DAPI address} other {# DAPI addresses}}"
msgstr "{count, plural, one {# адрес DAPI} few {# адреса DAPI} many {# адресов DAPI} other {# адреса DAPI}}"

msgid "Add a devnet"
msgstr "Добавить devnet"

msgid "Add devnet"
msgstr "Добавить devnet"

msgid "Amounts"
msgstr "Суммы"

msgid "Amounts show in {unitName}."
msgstr "Суммы показываются в {unitName}."

msgid "Amounts show in {unitName}. Choose USD to lead with the dollar value."
msgstr "Суммы показываются в {unitName}. Выберите USD, чтобы сначала показывать сумму в долларах."

msgid "Cancel"
msgstr "Отмена"

msgid "Custom devnets"
msgstr "Пользовательские devnet"

msgid "DAPI addresses"
msgstr "Адреса DAPI"

msgid "Devnet name"
msgstr "Название devnet"

msgid "Edit"
msgstr "Изменить"

msgid "Edit {editName}"
msgstr "Изменить {editName}"

msgid "Enter at least one DAPI address as host:port, one per line."
msgstr "Введите хотя бы один адрес DAPI в формате хост:порт, по одному в строке."

msgid "Example"
msgstr "Пример"

msgid "Language"
msgstr "Язык"

msgid "No devnets saved."
msgstr "Сохранённых devnet нет."

msgid "Open"
msgstr "Открыть"

msgid "optional"
msgstr "необязательно"

msgid "Otherwise times follow this device’s time zone. Hovering a time always shows UTC."
msgstr "Иначе время показывается в часовом поясе этого устройства. При наведении на время всегда отображается UTC."

msgid "Quorum list URL"
msgstr "URL списка кворумов"

#. placeholder {0}: formatFiat(DUFFS_PER_DASH, rate.data.data.usd)
#. placeholder {1}: rate.data.data.provider
msgid "Rate: {0} per DASH, from {1}."
msgstr "Курс: {0} за DASH, источник — {1}."

msgid "Remove"
msgstr "Удалить"

msgid "Remove {devnet}"
msgstr "Удалить {devnet}"

msgid "Save changes"
msgstr "Сохранить изменения"

msgid "Saved devnets"
msgstr "Сохранённые devnet"

msgid "Saved in this browser. A devnet with a name Radar doesn’t know asks for its addresses."
msgstr "Сохранено в этом браузере. Для devnet с неизвестным Radar названием потребуются его адреса."

msgid "See every source"
msgstr "Посмотреть все источники"

msgid "Settings"
msgstr "Настройки"

msgid "Show the USD value next to DASH amounts"
msgstr "Показывать стоимость в USD рядом с суммами в DASH"

msgid "Show times in UTC"
msgstr "Показывать время в UTC"

msgid "Sources"
msgstr "Источники"

msgid "Test coins have no value, so Testnet and devnets never show USD."
msgstr "У тестовых монет нет стоимости, поэтому в тестовой сети и devnet USD не показывается."

msgid "Text that isn’t translated yet appears in English. Hashes, IDs and amounts are never translated."
msgstr "Текст, который ещё не переведён, отображается на английском. Хеши, ID и суммы никогда не переводятся."

msgid "The quorum list URL must start with https://."
msgstr "URL списка кворумов должен начинаться с https://."

msgid "These choices stay in this browser. Radar never sends them anywhere."
msgstr "Эти настройки хранятся в этом браузере. Radar никогда никуда их не отправляет."

msgid "Times"
msgstr "Время"

msgid "Unit for amounts"
msgstr "Единица для сумм"

msgid "USD comes first, with the DASH figure after it once the rate is in."
msgstr "Сначала показывается USD, затем сумма в DASH, когда курс получен."

msgid "USD is for mainnet only: test coins have no value."
msgstr "USD доступен только в mainnet: тестовые монеты ничего не стоят."

msgid "USD is rounded to three significant figures and follows the amount in {unitName}."
msgstr "USD округляется до трёх значащих цифр и следует за суммой в {unitName}."

msgid "USD is rounded to three significant figures. This choice doesn’t apply while USD comes first."
msgstr "USD округляется до трёх значащих цифр. Этот выбор не действует, пока USD показывается первым."

msgid "Use lowercase letters, digits and hyphens, for example \"ruby\"."
msgstr "Используйте строчные буквы, цифры и дефисы, например «ruby»."

msgid "You"
msgstr "Вы"
