#. placeholder {0}: stats.missing
msgid "{0, plural, one {# masternode is not on the map: no address registered, or not crawled yet.} other {# masternodes are not on the map: no address registered, or not crawled yet.}}"
msgstr "{0, plural, one {# мастернода не показана на карте: адрес не зарегистрирован или ещё не опрошен.} few {# мастернод не показаны на карте: адрес не зарегистрирован или ещё не опрошен.} many {# мастернод не показаны на карте: адрес не зарегистрирован или ещё не опрошен.} other {# мастернод не показаны на карте: адрес не зарегистрирован или ещё не опрошен.}}"

#. placeholder {0}: totals.unlocated
msgid "{0, plural, one {# reachable node on Tor or I2P has no location, so it is not drawn.} other {# reachable nodes on Tor or I2P have no location, so they are not drawn.}}"
msgstr "{0, plural, one {# доступный узел в Tor или I2P не имеет местоположения, поэтому не показан.} few {# доступных узла в Tor или I2P не имеют местоположения, поэтому не показаны.} many {# доступных узлов в Tor или I2P не имеют местоположения, поэтому не показаны.} other {# доступных узла в Tor или I2P не имеют местоположения, поэтому не показаны.}}"

