msgstr "В последнем обходе ответили {answered} из {total}: {enabledAnswered} из {enabled} включённых и {bannedAnswered} из {banned} забаненных PoSe."

msgid "{answered} of {total} answered the latest crawl."
msgstr "В последнем обходе ответили {answered} из {total}."

