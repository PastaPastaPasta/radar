msgid "Reachable nodes counted per city, never by address, and how many have no location."
msgstr "Доступные узлы, подсчитанные по городам (никогда по адресам), и сколько из них без местоположения."

msgid "Registered"
msgstr "Зарегистрирована"

msgid "Registrations and removals"
msgstr "Регистрации и удаления"

msgid "Same location"
msgstr "То же место"

