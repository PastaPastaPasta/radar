msgid "Hide {0}"
msgstr "Скрыть: {0}"

msgid "Hosting"
msgstr "Хостинг"

msgid "How the data is collected"
msgstr "Как собираются данные"

msgid "In the paths, {NET} is mainnet or testnet. Amounts are in duffs (1 DASH = 100,000,000 duffs) except Platform amounts, which are in credits (1 DASH = 100,000,000,000 credits). Times are unix seconds."
msgstr "В путях {NET} — это mainnet или testnet. Суммы указаны в даффах (1 DASH = 100 000 000 даффов), кроме сумм Platform — они в кредитах (1 DASH = 100 000 000 000 кредитов). Время — в секундах unix."

msgid "Kind of change"
msgstr "Вид изменения"

msgid "Last paid"
msgstr "Последняя выплата"

msgid "Latest masternode list changes"
msgstr "Последние изменения списка мастернод"

msgid "Left the list"
msgstr "Вышла из списка"

