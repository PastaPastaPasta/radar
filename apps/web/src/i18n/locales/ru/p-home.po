#. placeholder {0}: formatInt(budget.usedLastMinute)
#. placeholder {1}: formatInt(budget.capacity)
msgid "{0} of {1}"
msgstr "{0} из {1}"

msgid "{behind} blocks behind the tip"
msgstr "Отставание от вершины: {behind} блоков"

msgid "A second index for addresses, spent outputs, chainwork and governance"
msgstr "Второй индекс для адресов, потраченных выходов, chainwork и управления"

msgid "Asking Platform for its latest block…"
msgstr "Запрашиваем у Platform последний блок…"

msgid "Best ChainLock"
msgstr "Лучший ChainLock"

#. placeholder {0}: formatPercent(chain.data.data.syncProgress, 1)
msgid "Catching up, {0}"
msgstr "Синхронизация, {0}"

msgid "ChainLock block hash, reported by one node"
msgstr "Хеш блока с ChainLock, сообщён одним узлом"

msgid "ChainLock reported by one node"
msgstr "ChainLock сообщён одним узлом"

msgid "ChainLocked block hash"
msgstr "Хеш блока с ChainLock"

msgid "Checking the sources…"
msgstr "Проверяем источники…"

msgid "Core"
msgstr "Core"

msgid "Core addresses, mempool, governance and block lists"
msgstr "Адреса Core, мемпул, управление и списки блоков"

msgid "Core tip"
msgstr "Вершина Core"

msgid "Core tip, blocks and transactions, straight from evonodes"
msgstr "Вершина Core, блоки и транзакции — напрямую от evonode"

msgid "DAPI"
msgstr "DAPI"

msgid "DAPI and the Platform SDK are answering. Hosted sources are off in Decentralized only mode."
msgstr "DAPI и Platform SDK отвечают. Размещённые источники отключены в режиме «Только децентрализованно»."

msgid "DAPI is busy, so block lists come from Hyphen while the budget recovers. Details still use DAPI."
msgstr "DAPI занят, поэтому списки блоков берутся из Hyphen, пока восстанавливается лимит запросов. Подробности по-прежнему идут через DAPI."

msgid "DAPI isn’t answering, so block and transaction details come from Hyphen and say so."
msgstr "DAPI не отвечает, поэтому сведения о блоках и транзакциях берутся из Hyphen, и это указано."

msgid "DAPI request budget"
msgstr "Лимит запросов к DAPI"

msgid "Dash Core"
msgstr "Dash Core"

msgid "Decentralized only mode doesn’t contact this source."
msgstr "Режим «Только децентрализованно» не обращается к этому источнику."

msgid "Details"
msgstr "Подробности"

msgid "Every source is answering."
msgstr "Все источники отвечают."

msgid "Everything Core shows comes from DAPI."
msgstr "Всё, что показывает Core, берётся из DAPI."

msgid "Figures computed on your device"
msgstr "Значения, вычисленные на вашем устройстве"

msgid "Getting tight"
msgstr "Запас сокращается"

msgid "Headers and blocks"
msgstr "Заголовки и блоки"

msgid "Headroom"
msgstr "Запас"

msgid "How each source is answering, and how far behind its data is."
msgstr "Как отвечает каждый источник и насколько отстают его данные."

msgid "Hyphen"
msgstr "Hyphen"

msgid "Indexed to Core block {indexed} of {chain}. It calls its sync “{sync}”, but its index is behind the chain."
msgstr "Проиндексировано до блока Core {indexed} из {chain}. Hyphen называет свою синхронизацию «{sync}», но её индекс отстаёт от цепочки."

msgid "Indexed to Core block {indexed} of {chain}. Sync: {sync}."
msgstr "Проиндексировано до блока Core {indexed} из {chain}. Синхронизация: {sync}."

msgid "Indexed to Platform block {indexed} of {chain}. Indexer: {state}."
msgstr "Проиндексировано до блока Platform {indexed} из {chain}. Индексатор: {state}."

msgid "Insight"
msgstr "Insight"

msgid "It answered with an error."
msgstr "Он ответил ошибкой."

msgid "It hasn’t answered yet."
msgstr "Он пока не ответил."

msgid "It is rate limiting this browser."
msgstr "Он ограничивает запросы из этого браузера."

msgid "It sent an answer Radar can’t read."
msgstr "Он прислал ответ, который Radar не может прочитать."

msgid "It took too long to answer."
msgstr "Он слишком долго не отвечал."

msgid "Its data is behind."
msgstr "Его данные отстают."

msgid "Its tip is Core block {tip}, behind the chain."
msgstr "Его вершина — блок Core {tip}, он отстаёт от цепочки."

msgid "Its tip is Core block {tip}."
msgstr "Его вершина — блок Core {tip}."

#. placeholder {0}: formatRelative(clampSkew(finished, now), now)
#. placeholder {1}: formatInt(status.chain.blocks)
msgid "Last crawl finished {0}. Its Core node is at block {1}."
msgstr "Последний обход завершён {0}. Его узел Core находится на блоке {1}."

#. placeholder {0}: ago(health.lastOkAt)
msgid "Last good {0}."
msgstr "Последний успех: {0}."

msgid "Median answer {rounded} ms"
msgstr "Медианное время ответа {rounded} мс"

msgid "Network internals: peers, mempool pressure, versions and history"
msgstr "Внутреннее устройство сети: пиры, нагрузка мемпула, версии и история"

msgid "No crawl has finished yet."
msgstr "Ни один обход ещё не завершён."

msgid "No DAPI requests have been made on this network yet."
msgstr "В этой сети ещё не было запросов к DAPI."

msgid "Node sync"
msgstr "Синхронизация узла"

msgid "Nodes resting"
msgstr "Простаивающие узлы"

msgid "Not available right now"
msgstr "Сейчас недоступно"

msgid "Not offered"
msgstr "Не предлагается"

msgid "Nothing has asked it yet on this network."
msgstr "В этой сети к нему ещё никто не обращался."

msgid "Off in this mode"
msgstr "В этом режиме отключено"

msgid "Platform Explorer"
msgstr "Platform Explorer"

msgid "Platform lists and counts"
msgstr "Списки и счётчики Platform"

msgid "Platform SDK"
msgstr "Platform SDK"

msgid "Plenty of room"
msgstr "Большой запас"

msgid "Pressure"
msgstr "Нагрузка"

msgid "Price feed"
msgstr "Источник цен"

msgid "Proof-checked at Platform block {block}, epoch {epoch}. That block is {age}."
msgstr "Подтверждено доказательством на блоке Platform {block}, эпоха {epoch}. Этому блоку {age}."

msgid "Proof-checked Platform state, verified in this browser"
msgstr "Состояние Platform, подтверждённое доказательством и проверенное в этом браузере"

msgid "Radar crawler"
msgstr "Обходчик Radar"

msgid "Radar keeps each evonode well under its rate limit, so one visitor can’t crowd out another."
msgstr "Radar держит нагрузку на каждую evonode заметно ниже её лимита запросов, чтобы один посетитель не вытеснял другого."

msgid "Requests in the last minute"
msgstr "Запросов за последнюю минуту"

msgid "Some requests are failing."
msgstr "Часть запросов завершается ошибкой."

msgid "Some sources are slow or behind. The rest still work."
msgstr "Некоторые источники медленные или отстают. Остальные работают."

msgid "Some sources aren’t answering. The rest still work."
msgstr "Некоторые источники не отвечают. Остальные работают."

msgid "Sources"
msgstr "Источники"

msgid "Status"
msgstr "Статус"

msgid "Synced"
msgstr "Синхронизировано"

msgid "The connection failed."
msgstr "Не удалось подключиться."

msgid "The masternode census and network history"
msgstr "Перепись мастернод и история сети"

msgid "The median answer takes {seconds} s."
msgstr "Медианное время ответа — {seconds} с."

msgid "The request budget is nearly used."
msgstr "Лимит запросов почти исчерпан."

msgid "The USD rate, through Platform Explorer"
msgstr "Курс USD через Platform Explorer"

msgid "This browser"
msgstr "Этот браузер"

msgid "This network doesn’t have this source."
msgstr "В этой сети нет такого источника."

msgid "Tip hash"
msgstr "Хеш вершины"

msgid "Used up for now"
msgstr "Пока исчерпан"

msgid "What the evonodes report about the chain right now."
msgstr "Что сейчас сообщают о цепочке evonode."
