msgid "—"
msgstr "—"

msgid "“{field}” has more than one clause. Use one, or a lower and an upper bound."
msgstr "У «{field}» больше одного условия. Оставьте одно или задайте нижнюю и верхнюю границы."

msgid "“{field}” isn’t in any index of this type, so Platform can’t filter on it."
msgstr "«{field}» нет ни в одном индексе этого типа, поэтому Platform не может по нему фильтровать."

msgid "“{field}” needs a clause on “{other}” first: index {index} is read in order, earlier properties before later ones."
msgstr "Для «{field}» сначала нужно условие по «{other}»: индекс {index} читается по порядку, сначала более ранние свойства."

msgid "“{field}” needs a value."
msgstr "Для «{field}» нужно значение."

msgid "“{field}” takes a whole number."
msgstr "«{field}» принимает целое число."

msgid "“{field}” takes an identifier: 32 bytes written in base58."
msgstr "«{field}» принимает идентификатор: 32 байта в формате base58."

msgid "“{field}” takes true or false."
msgstr "«{field}» принимает true или false."

msgid "“starts with” works on text, and “{field}” isn’t text."
msgstr "«начинается с» работает с текстом, а «{field}» — не текст."

msgid "{changeCount, plural, one {# change} other {# changes}}"
msgstr "{changeCount, plural, one {# изменение} few {# изменения} many {# изменений} other {# изменения}}"

msgid "{count, plural, one {# signer} other {# signers}}"
msgstr "{count, plural, one {# подписант} few {# подписанта} many {# подписантов} other {# подписанта}}"

msgid "{f}, ascending"
msgstr "{f}, по возрастанию"

msgid "{f}, descending"
msgstr "{f}, по убыванию"

msgid "{field}: searching “{searched}” for “{typed}” (DPNS stores o, i and l as 0, 1 and 1)"
msgstr "{field}: поиск «{searched}» вместо «{typed}» (DPNS хранит o, i и l как 0, 1 и 1)"

msgid "{pinnedOrderField}, ascending"
msgstr "{pinnedOrderField}, по возрастанию"

msgid "{pinnedOrderField}, descending"
msgstr "{pinnedOrderField}, по убыванию"

msgid "{props} properties · {indices} indices"
msgstr "{props} свойств · {indices} индексов"

msgid "{signerCount}, power {signedPower} of {requiredPower} required"
msgstr "{signerCount}, вес {signedPower} из требуемых {requiredPower}"

msgid "A contract can hold only tokens or groups."
msgstr "Контракт может содержать только токены или только группы."

msgid "A contract ID"
msgstr "ID контракта"

msgid "A contract ID is 44 base58 characters or fewer."
msgstr "ID контракта — не более 44 символов base58."

msgid "A group lists identities and the power each holds; a decision needs enough power to reach the group’s threshold."
msgstr "Группа перечисляет идентичности и вес каждой; для решения нужно набрать вес, достаточный для порога группы."

msgid "A query can have only one “in” clause."
msgstr "В запросе может быть только одно условие «in»."

msgid "A range (<, ≤, >, ≥, starts with) on “{field}” must be on the last property you filter on in index {index}, but “{other}” comes after it."
msgstr "Диапазон (<, ≤, >, ≥, начинается с) по «{field}» должен быть на последнем фильтруемом свойстве индекса {index}, но «{other}» идёт после него."

