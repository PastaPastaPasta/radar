msgid "Up to {MAX_STATEMENTS} statements run at once; this has {0}."
msgstr "За раз выполняется до {MAX_STATEMENTS} инструкций; здесь их {0}."

msgid "Use == for an exact match. LIKE is only a prefix match here."
msgstr "Используйте == для точного совпадения. LIKE здесь — только совпадение по префиксу."

msgid "Use ==, >, >=, <, <=, BETWEEN … AND …, IN (…) or STARTS WITH."
msgstr "Используйте ==, >, >=, <, <=, BETWEEN … AND …, IN (…) или STARTS WITH."

msgid "Value"
msgstr "Значение"

msgid "Vote"
msgstr "Голос"

msgid "Voting state"
msgstr "Состояние голосования"

msgid "What the proof contains"
msgstr "Что содержит доказательство"

msgid "Which Platform SDK call backs each Radar page, with its arguments."
msgstr "Какой вызов SDK Platform обслуживает каждую страницу Radar, с аргументами."

msgid "Write a literal prefix and one trailing %, as in LIKE 'abc%', or use STARTS WITH for a prefix that holds % or _."
msgstr "Напишите буквальный префикс и один % в конце, как в LIKE 'abc%', или используйте STARTS WITH для префикса, содержащего % или _."

msgid "Write a query to run."
msgstr "Напишите запрос для выполнения."

msgid "Write text between single quotes, and write a quote inside the text twice."
msgstr "Пишите текст в одинарных кавычках, а кавычку внутри текста удваивайте."

msgid "Write text values, including IDs, in single quotes."
msgstr "Текстовые значения, включая ID, пишите в одинарных кавычках."

msgid "You can keep up to 20 queries here. Delete one first."
msgstr "Здесь можно хранить до 20 запросов. Сначала удалите один."

msgid "Your browser"
msgstr "Ваш браузер"
