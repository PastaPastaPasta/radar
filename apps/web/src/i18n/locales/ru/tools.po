msgid "“{arg}” has no wildcard."
msgstr "В “{arg}” нет подстановочного знака."

msgid "“{arg}” isn't a number."
msgstr "“{arg}” — не число."

msgid "“{arg}” isn't an operator Platform knows."
msgstr "“{arg}” — не оператор, известный Platform."

msgid "“{arg}” isn't supported here."
msgstr "“{arg}” здесь не поддерживается."

msgid "“{arg}” isn't supported."
msgstr "“{arg}” не поддерживается."

msgid "“{arg}” needs quotes."
msgstr "“{arg}” нужно взять в кавычки."

