#. placeholder {1}: formatBytes(parsed.bytes.length)
msgid "{0}, {1}. Decoded here: the bytes are not sent anywhere."
msgstr "{0}, {1}. Расшифровано здесь: байты никуда не отправляются."

msgid "A document's bytes only mean something against its contract. Radar fetches the contract once, checks its proof here and keeps it to decode with."
msgstr "Байты документа имеют смысл только относительно его контракта. Radar один раз получает контракт, проверяет его доказательство здесь и сохраняет для расшифровки."

msgid "A field name in backticks is missing its closing backtick."
msgstr "В имени поля в обратных кавычках не хватает закрывающей обратной кавычки."

msgid "A field name was expected, but “{arg}” came instead."
msgstr "Ожидалось имя поля, но встретилось “{arg}”."

msgid "A filter follows one index: the fields it names must be an index's leading fields, matched with == or IN, and the last of them may take a range (<, <=, >, >=, BETWEEN) or STARTS WITH. Add ORDER BY for each field you filter with a range or IN."
msgstr "Фильтр следует одному индексу: названные в нём поля должны быть ведущими полями индекса и сравниваться через == или IN, а последнее из них может принимать диапазон (<, <=, >, >=, BETWEEN) или STARTS WITH. Добавьте ORDER BY для каждого поля, которое вы фильтруете по диапазону или IN."

msgid "A name by its label"
msgstr "Имя по его метке"

msgid "A number was expected, but “{arg}” came instead."
msgstr "Ожидалось число, но встретилось “{arg}”."

msgid "A query is SELECT … FROM … WHERE conditions joined by AND, then GROUP BY, ORDER BY and LIMIT. JOIN, OR, OFFSET and sub-queries are unavailable because Platform answers from one index."
msgstr "Запрос — это SELECT … FROM … WHERE с условиями, соединёнными AND, затем GROUP BY, ORDER BY и LIMIT. JOIN, OR, OFFSET и подзапросы недоступны, потому что Platform отвечает по одному индексу."

msgid "A statement can name a contract itself, as in FROM dpns.domain."
msgstr "Инструкция может сама назвать контракт, как в FROM dpns.domain."

msgid "A string is missing its closing quote."
msgstr "В строке не хватает закрывающей кавычки."

msgid "A sum over a range"
msgstr "Сумма по диапазону"

msgid "A value was expected, but “{arg}” came instead."
msgstr "Ожидалось значение, но встретилось “{arg}”."

msgid "A whole number was expected, but “{arg}” came instead."
msgstr "Ожидалось целое число, но встретилось “{arg}”."

msgid "Action"
msgstr "Действие"

msgid "Add ORDER BY for every field filtered with a range (<, >, BETWEEN, STARTS WITH) or IN."
msgstr "Добавьте ORDER BY для каждого поля, фильтруемого по диапазону (<, >, BETWEEN, STARTS WITH) или IN."

