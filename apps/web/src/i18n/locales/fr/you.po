msgid "{count, plural, one {# DAPI address} other {# DAPI addresses}}"
msgstr "{count, plural, one {# adresse DAPI} many {# d’adresses DAPI} other {# adresses DAPI}}"

msgid "Add a devnet"
msgstr "Ajouter un devnet"

msgid "Add devnet"
msgstr "Ajouter le devnet"

msgid "Amounts"
msgstr "Montants"

msgid "Amounts show in {unitName}."
msgstr "Les montants s’affichent en {unitName}."

msgid "Amounts show in {unitName}. Choose USD to lead with the dollar value."
msgstr "Les montants s’affichent en {unitName}. Choisissez USD pour mettre la valeur en dollars en premier."

msgid "Cancel"
msgstr "Annuler"

msgid "Custom devnets"
msgstr "Devnets personnalisés"

msgid "DAPI addresses"
msgstr "Adresses DAPI"

msgid "Devnet name"
msgstr "Nom du devnet"

msgid "Edit"
msgstr "Modifier"

msgid "Edit {editName}"
msgstr "Modifier {editName}"

msgid "Enter at least one DAPI address as host:port, one per line."
msgstr "Saisissez au moins une adresse DAPI au format hôte:port, une par ligne."

msgid "Example"
msgstr "Exemple"

msgid "Language"
msgstr "Langue"

msgid "No devnets saved."
msgstr "Aucun devnet enregistré."

msgid "Open"
msgstr "Ouvrir"

msgid "optional"
msgstr "facultatif"

msgid "Otherwise times follow this device’s time zone. Hovering a time always shows UTC."
msgstr "Sinon, les heures suivent le fuseau horaire de cet appareil. Survoler une heure affiche toujours l’UTC."

msgid "Quorum list URL"
msgstr "URL de la liste des quorums"

#. placeholder {0}: formatFiat(DUFFS_PER_DASH, rate.data.data.usd)
#. placeholder {1}: rate.data.data.provider
msgid "Rate: {0} per DASH, from {1}."
msgstr "Taux : {0} par DASH, depuis {1}."

msgid "Remove"
msgstr "Supprimer"

msgid "Remove {devnet}"
msgstr "Supprimer {devnet}"

msgid "Save changes"
msgstr "Enregistrer les modifications"

msgid "Saved devnets"
msgstr "Devnets enregistrés"

msgid "Saved in this browser. A devnet with a name Radar doesn’t know asks for its addresses."
msgstr "Enregistré dans ce navigateur. Un devnet dont le nom est inconnu de Radar demande ses adresses."

msgid "See every source"
msgstr "Voir toutes les sources"

msgid "Settings"
msgstr "Paramètres"

msgid "Show the USD value next to DASH amounts"
msgstr "Afficher la valeur en USD à côté des montants en DASH"

msgid "Show times in UTC"
msgstr "Afficher les heures en UTC"

msgid "Sources"
msgstr "Sources"

msgid "Test coins have no value, so Testnet and devnets never show USD."
msgstr "Les pièces de test n’ont aucune valeur : le testnet et les devnets n’affichent donc jamais d’USD."

msgid "Text that isn’t translated yet appears in English. Hashes, IDs and amounts are never translated."
msgstr "Ce qui n’est pas encore traduit apparaît en anglais. Les hashes, les ID et les montants ne sont jamais traduits."

msgid "The quorum list URL must start with https://."
msgstr "L’URL de la liste des quorums doit commencer par https://."

msgid "These choices stay in this browser. Radar never sends them anywhere."
msgstr "Ces choix restent dans ce navigateur. Radar ne les envoie nulle part."

msgid "Times"
msgstr "Heures"

msgid "Unit for amounts"
msgstr "Unité des montants"

msgid "USD comes first, with the DASH figure after it once the rate is in."
msgstr "L’USD passe en premier, suivi du montant en DASH dès que le taux est connu."

msgid "USD is for mainnet only: test coins have no value."
msgstr "L’USD n’est disponible que sur le mainnet : les pièces de test n’ont aucune valeur."

msgid "USD is rounded to three significant figures and follows the amount in {unitName}."
msgstr "L’USD est arrondi à trois chiffres significatifs et suit le montant en {unitName}."

msgid "USD is rounded to three significant figures. This choice doesn’t apply while USD comes first."
msgstr "L’USD est arrondi à trois chiffres significatifs. Ce choix ne s’applique pas tant que l’USD passe en premier."

msgid "Use lowercase letters, digits and hyphens, for example \"ruby\"."
msgstr "Utilisez des lettres minuscules, des chiffres et des tirets, par exemple « ruby »."

msgid "You"
msgstr "Vous"
