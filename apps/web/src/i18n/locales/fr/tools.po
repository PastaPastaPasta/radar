msgid "Up to {MAX_STATEMENTS} statements run at once; this has {0}."
msgstr "Jusqu’à {MAX_STATEMENTS} instructions s’exécutent à la fois ; celle-ci en a {0}."

msgid "Use == for an exact match. LIKE is only a prefix match here."
msgstr "Utilisez == pour une correspondance exacte. LIKE n’est ici qu’une correspondance de préfixe."

msgid "Use ==, >, >=, <, <=, BETWEEN … AND …, IN (…) or STARTS WITH."
msgstr "Utilisez ==, >, >=, <, <=, BETWEEN … AND …, IN (…) ou STARTS WITH."

msgid "Value"
msgstr "Valeur"

msgid "Vote"
msgstr "Vote"

msgid "Voting state"
msgstr "État du vote"

msgid "What the proof contains"
msgstr "Ce que contient la preuve"

msgid "Which Platform SDK call backs each Radar page, with its arguments."
msgstr "Quel appel du SDK Platform alimente chaque page de Radar, avec ses arguments."

msgid "Write a literal prefix and one trailing %, as in LIKE 'abc%', or use STARTS WITH for a prefix that holds % or _."
msgstr "Écrivez un préfixe littéral suivi d’un seul %, comme dans LIKE 'abc%', ou utilisez STARTS WITH pour un préfixe contenant % ou _."

msgid "Write a query to run."
msgstr "Écrivez une requête à exécuter."

msgid "Write text between single quotes, and write a quote inside the text twice."
msgstr "Écrivez le texte entre apostrophes, et doublez une apostrophe à l’intérieur du texte."

msgid "Write text values, including IDs, in single quotes."
msgstr "Écrivez les valeurs de texte, ID compris, entre apostrophes."

msgid "You can keep up to 20 queries here. Delete one first."
msgstr "Vous pouvez conserver jusqu’à 20 requêtes ici. Supprimez-en une d’abord."

msgid "Your browser"
msgstr "Votre navigateur"
