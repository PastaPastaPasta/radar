msgid "“{field}” has more than one clause. Use one, or a lower and an upper bound."
msgstr "« {field} » a plus d’une clause. Utilisez-en une, ou une borne inférieure et une borne supérieure."

msgid "“{field}” isn’t in any index of this type, so Platform can’t filter on it."
msgstr "« {field} » ne figure dans aucun index de ce type : Platform ne peut donc pas filtrer dessus."

msgid "“{field}” needs a clause on “{other}” first: index {index} is read in order, earlier properties before later ones."
msgstr "« {field} » demande d’abord une clause sur « {other} » : l’index {index} se lit dans l’ordre, les propriétés précédentes avant les suivantes."

msgid "“{field}” needs a value."
msgstr "« {field} » a besoin d’une valeur."

msgid "“{field}” takes a whole number."
msgstr "« {field} » attend un nombre entier."

msgid "“{field}” takes an identifier: 32 bytes written in base58."
msgstr "« {field} » attend un identifiant : 32 octets écrits en base58."

msgid "“{field}” takes true or false."
msgstr "« {field} » attend true ou false."

msgid "“starts with” works on text, and “{field}” isn’t text."
msgstr "« commence par » s’applique au texte, et « {field} » n’est pas du texte."

