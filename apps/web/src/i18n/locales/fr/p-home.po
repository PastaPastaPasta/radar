#. placeholder {0}: formatInt(budget.usedLastMinute)
#. placeholder {1}: formatInt(budget.capacity)
msgid "{0} of {1}"
msgstr "{0} sur {1}"

msgid "{behind} blocks behind the tip"
msgstr "{behind} blocs de retard sur la tête"

msgid "A second index for addresses, spent outputs, chainwork and governance"
msgstr "Un second index pour les adresses, les sorties dépensées, le chainwork et la gouvernance"

msgid "Asking Platform for its latest block…"
msgstr "Interrogation de Platform sur son dernier bloc…"

msgid "Best ChainLock"
msgstr "Dernier ChainLock"

#. placeholder {0}: formatPercent(chain.data.data.syncProgress, 1)
msgid "Catching up, {0}"
msgstr "Rattrapage en cours, {0}"

msgid "ChainLock block hash, reported by one node"
msgstr "Hash du bloc ChainLock, signalé par un nœud"

msgid "ChainLock reported by one node"
msgstr "ChainLock signalé par un seul nœud"

msgid "ChainLocked block hash"
msgstr "Hash du bloc ChainLocked"

msgid "Checking the sources…"
msgstr "Vérification des sources…"

msgid "Core"
msgstr "Core"

msgid "Core addresses, mempool, governance and block lists"
msgstr "Adresses Core, mempool, governance et listes de blocs"

msgid "Core tip"
msgstr "Pointe de Core"

msgid "Core tip, blocks and transactions, straight from evonodes"
msgstr "Pointe de Core, blocs et transactions, directement depuis les evonodes"

msgid "DAPI"
msgstr "DAPI"

msgid "DAPI and the Platform SDK are answering. Hosted sources are off in Decentralized only mode."
msgstr "DAPI et le SDK Platform répondent. Les sources hébergées sont désactivées en mode « Décentralisé uniquement »."

msgid "DAPI is busy, so block lists come from Hyphen while the budget recovers. Details still use DAPI."
msgstr "DAPI est occupé : les listes de blocs viennent de Hyphen le temps que le budget se rétablisse. Les détails utilisent toujours DAPI."

msgid "DAPI isn’t answering, so block and transaction details come from Hyphen and say so."
msgstr "DAPI ne répond pas : les détails des blocs et des transactions viennent de Hyphen, et cela est indiqué."

msgid "DAPI request budget"
msgstr "Budget de requêtes DAPI"

msgid "Dash Core"
msgstr "Dash Core"

msgid "Decentralized only mode doesn’t contact this source."
msgstr "Le mode « Décentralisé uniquement » ne contacte pas cette source."

msgid "Details"
msgstr "Détails"

msgid "Every source is answering."
msgstr "Toutes les sources répondent."

msgid "Everything Core shows comes from DAPI."
msgstr "Tout ce que Core affiche provient de DAPI."

msgid "Figures computed on your device"
msgstr "Chiffres calculés sur votre appareil"

msgid "Getting tight"
msgstr "Ça se resserre"

msgid "Headers and blocks"
msgstr "En-têtes et blocs"

msgid "Headroom"
msgstr "Marge"

msgid "How each source is answering, and how far behind its data is."
msgstr "Comment chaque source répond et quel retard ont ses données."

msgid "Hyphen"
msgstr "Hyphen"

msgid "Indexed to Core block {indexed} of {chain}. It calls its sync “{sync}”, but its index is behind the chain."
msgstr "Indexé jusqu’au bloc Core {indexed} sur {chain}. Hyphen dit que sa synchronisation est « {sync} », mais son index est en retard sur la chaîne."

msgid "Indexed to Core block {indexed} of {chain}. Sync: {sync}."
msgstr "Indexé jusqu’au bloc Core {indexed} sur {chain}. Synchronisation : {sync}."

msgid "Indexed to Platform block {indexed} of {chain}. Indexer: {state}."
msgstr "Indexé jusqu’au bloc Platform {indexed} sur {chain}. Indexeur : {state}."

msgid "Insight"
msgstr "Insight"

msgid "It answered with an error."
msgstr "Elle a répondu par une erreur."

msgid "It hasn’t answered yet."
msgstr "Elle n’a pas encore répondu."

msgid "It is rate limiting this browser."
msgstr "Elle limite le débit de ce navigateur."

msgid "It sent an answer Radar can’t read."
msgstr "Elle a envoyé une réponse que Radar ne peut pas lire."

msgid "It took too long to answer."
msgstr "Elle a mis trop de temps à répondre."

msgid "Its data is behind."
msgstr "Ses données sont en retard."

msgid "Its tip is Core block {tip}, behind the chain."
msgstr "Sa pointe est le bloc Core {tip}, en retard sur la chaîne."

msgid "Its tip is Core block {tip}."
msgstr "Sa pointe est le bloc Core {tip}."

#. placeholder {0}: formatRelative(clampSkew(finished, now), now)
#. placeholder {1}: formatInt(status.chain.blocks)
msgid "Last crawl finished {0}. Its Core node is at block {1}."
msgstr "Le dernier crawl s’est terminé {0}. Son nœud Core est au bloc {1}."

#. placeholder {0}: ago(health.lastOkAt)
msgid "Last good {0}."
msgstr "Dernier succès {0}."

msgid "Median answer {rounded} ms"
msgstr "Temps de réponse médian {rounded} ms"

msgid "Network internals: peers, mempool pressure, versions and history"
msgstr "Fonctionnement interne du réseau : pairs, pression du mempool, versions et historique"

msgid "No crawl has finished yet."
msgstr "Aucun crawl n’est encore terminé."

msgid "No DAPI requests have been made on this network yet."
msgstr "Aucune requête DAPI n’a encore été faite sur ce réseau."

msgid "Node sync"
msgstr "Synchronisation du nœud"

msgid "Nodes resting"
msgstr "Nœuds au repos"

msgid "Not available right now"
msgstr "Indisponible pour le moment"

msgid "Not offered"
msgstr "Non proposé"

msgid "Nothing has asked it yet on this network."
msgstr "Personne ne l’a encore interrogée sur ce réseau."

msgid "Off in this mode"
msgstr "Désactivé dans ce mode"

msgid "Platform Explorer"
msgstr "Platform Explorer"

msgid "Platform lists and counts"
msgstr "Listes et compteurs Platform"

msgid "Platform SDK"
msgstr "SDK Platform"

msgid "Plenty of room"
msgstr "Beaucoup de marge"

msgid "Pressure"
msgstr "Pression"

msgid "Price feed"
msgstr "Flux de prix"

msgid "Proof-checked at Platform block {block}, epoch {epoch}. That block is {age}."
msgstr "Preuve vérifiée au bloc {block} de Platform, époque {epoch}. Ce bloc date de {age}."

msgid "Proof-checked Platform state, verified in this browser"
msgstr "État Platform vérifié par preuve, contrôlé dans ce navigateur"

msgid "Radar crawler"
msgstr "Crawler de Radar"

msgid "Radar keeps each evonode well under its rate limit, so one visitor can’t crowd out another."
msgstr "Radar maintient chaque evonode bien en dessous de sa limite de débit, afin qu’un visiteur n’en évince pas un autre."

msgid "Requests in the last minute"
msgstr "Requêtes de la dernière minute"

msgid "Some requests are failing."
msgstr "Certaines requêtes échouent."

msgid "Some sources are slow or behind. The rest still work."
msgstr "Certaines sources sont lentes ou en retard. Les autres fonctionnent toujours."

msgid "Some sources aren’t answering. The rest still work."
msgstr "Certaines sources ne répondent pas. Les autres fonctionnent toujours."

msgid "Sources"
msgstr "Sources"

msgid "Status"
msgstr "Statut"

msgid "Synced"
msgstr "Synchronisé"

msgid "The connection failed."
msgstr "La connexion a échoué."

msgid "The masternode census and network history"
msgstr "Le recensement des masternodes et l’historique du réseau"

msgid "The median answer takes {seconds} s."
msgstr "Le temps de réponse médian est de {seconds} s."

msgid "The request budget is nearly used."
msgstr "Le budget de requêtes est presque épuisé."

msgid "The USD rate, through Platform Explorer"
msgstr "Le taux USD via Platform Explorer"

msgid "This browser"
msgstr "Ce navigateur"

msgid "This network doesn’t have this source."
msgstr "Ce réseau n’a pas cette source."

msgid "Tip hash"
msgstr "Hash de la pointe"

msgid "Used up for now"
msgstr "Épuisé pour l’instant"

msgid "What the evonodes report about the chain right now."
msgstr "Ce que les evonodes rapportent actuellement sur la chaîne."
