msgstr "PoSe 状态"

msgid "PoSe-banned"
msgstr "已被 PoSe 封禁"

msgid "Radar API"
msgstr "Radar API"

msgid "Radar doesn't crawl devnets."
msgstr "Radar 不抓取开发网。"

msgid "Reachability"
msgstr "可达性"

msgid "Reachable"
msgstr "可达"

msgid "Reachable nodes counted per city, never by address, and how many have no location."
msgstr "按城市统计可达节点（绝不按地址），以及有多少节点没有位置信息。"

msgid "Registered"
msgstr "注册"

msgid "Registrations and removals"
msgstr "注册与移除"

msgid "Same location"
msgstr "同一位置"

msgid "Search masternodes"
msgstr "搜索主节点"

