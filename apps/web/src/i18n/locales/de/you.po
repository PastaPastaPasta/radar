msgid "{count, plural, one {# DAPI address} other {# DAPI addresses}}"
msgstr "{count, plural, one {# DAPI-Adresse} other {# DAPI-Adressen}}"

msgid "Add a devnet"
msgstr "Devnet hinzufügen"

msgid "Add devnet"
msgstr "Devnet hinzufügen"

msgid "Amounts"
msgstr "Beträge"

msgid "Amounts show in {unitName}."
msgstr "Beträge werden in {unitName} angezeigt."

msgid "Amounts show in {unitName}. Choose USD to lead with the dollar value."
msgstr "Beträge werden in {unitName} angezeigt. Wähle USD, damit der Dollarwert vorne steht."

msgid "Cancel"
msgstr "Abbrechen"

msgid "Custom devnets"
msgstr "Eigene Devnets"

msgid "DAPI addresses"
msgstr "DAPI-Adressen"

msgid "Devnet name"
msgstr "Devnet-Name"

msgid "Edit"
msgstr "Bearbeiten"

msgid "Edit {editName}"
msgstr "{editName} bearbeiten"

msgid "Enter at least one DAPI address as host:port, one per line."
msgstr "Gib mindestens eine DAPI-Adresse als Host:Port ein, eine pro Zeile."

msgid "Example"
msgstr "Beispiel"

msgid "Language"
msgstr "Sprache"

msgid "No devnets saved."
msgstr "Keine Devnets gespeichert."

msgid "Open"
msgstr "Öffnen"

msgid "optional"
msgstr "optional"

msgid "Otherwise times follow this device’s time zone. Hovering a time always shows UTC."
msgstr "Andernfalls richten sich die Zeiten nach der Zeitzone dieses Geräts. Beim Überfahren einer Zeit wird immer UTC angezeigt."

msgid "Quorum list URL"
msgstr "URL der Quorum-Liste"

#. placeholder {0}: formatFiat(DUFFS_PER_DASH, rate.data.data.usd)
#. placeholder {1}: rate.data.data.provider
msgid "Rate: {0} per DASH, from {1}."
msgstr "Kurs: {0} pro DASH, von {1}."

msgid "Remove"
msgstr "Entfernen"

msgid "Remove {devnet}"
msgstr "{devnet} entfernen"

msgid "Save changes"
msgstr "Änderungen speichern"

msgid "Saved devnets"
msgstr "Gespeicherte Devnets"

msgid "Saved in this browser. A devnet with a name Radar doesn’t know asks for its addresses."
msgstr "In diesem Browser gespeichert. Ein Devnet mit einem Namen, den Radar nicht kennt, verlangt seine Adressen."

msgid "See every source"
msgstr "Alle Quellen ansehen"

msgid "Settings"
msgstr "Einstellungen"

msgid "Show the USD value next to DASH amounts"
msgstr "USD-Wert neben DASH-Beträgen anzeigen"

msgid "Show times in UTC"
msgstr "Zeiten in UTC anzeigen"

msgid "Sources"
msgstr "Quellen"

msgid "Test coins have no value, so Testnet and devnets never show USD."
msgstr "Testcoins haben keinen Wert, daher zeigen Testnet und Devnets nie USD an."

msgid "Text that isn’t translated yet appears in English. Hashes, IDs and amounts are never translated."
msgstr "Was noch nicht übersetzt ist, erscheint auf Englisch. Hashes, IDs und Beträge werden nie übersetzt."

msgid "The quorum list URL must start with https://."
msgstr "Die URL der Quorum-Liste muss mit https:// beginnen."

msgid "These choices stay in this browser. Radar never sends them anywhere."
msgstr "Diese Einstellungen bleiben in diesem Browser. Radar sendet sie nirgendwohin."

msgid "Times"
msgstr "Zeiten"

msgid "Unit for amounts"
msgstr "Einheit für Beträge"

msgid "USD comes first, with the DASH figure after it once the rate is in."
msgstr "USD steht zuerst, der DASH-Wert folgt dahinter, sobald der Kurs vorliegt."

msgid "USD is for mainnet only: test coins have no value."
msgstr "USD gibt es nur im Mainnet: Testcoins haben keinen Wert."

msgid "USD is rounded to three significant figures and follows the amount in {unitName}."
msgstr "USD wird auf drei signifikante Stellen gerundet und folgt dem Betrag in {unitName}."

msgid "USD is rounded to three significant figures. This choice doesn’t apply while USD comes first."
msgstr "USD wird auf drei signifikante Stellen gerundet. Diese Auswahl gilt nicht, solange USD zuerst steht."

msgid "Use lowercase letters, digits and hyphens, for example \"ruby\"."
msgstr "Verwende Kleinbuchstaben, Ziffern und Bindestriche, zum Beispiel „ruby“."

msgid "You"
msgstr "Du"
