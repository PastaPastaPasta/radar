#. placeholder {0}: formatInt(budget.usedLastMinute)
#. placeholder {1}: formatInt(budget.capacity)
msgid "{0} of {1}"
msgstr "{0} von {1}"

msgid "{behind} blocks behind the tip"
msgstr "{behind} Blöcke hinter der Spitze"

msgid "A second index for addresses, spent outputs, chainwork and governance"
msgstr "Ein zweiter Index für Adressen, ausgegebene Outputs, Chainwork und Governance"

msgid "Asking Platform for its latest block…"
msgstr "Platform wird nach dem neuesten Block gefragt …"

msgid "Best ChainLock"
msgstr "Letzter ChainLock"

#. placeholder {0}: formatPercent(chain.data.data.syncProgress, 1)
msgid "Catching up, {0}"
msgstr "Wird aufgeholt, {0}"

msgid "ChainLock block hash, reported by one node"
msgstr "Hash des ChainLock-Blocks, von einem Knoten gemeldet"

msgid "ChainLock reported by one node"
msgstr "ChainLock von einem Knoten gemeldet"

msgid "ChainLocked block hash"
msgstr "Hash des ChainLocked-Blocks"

msgid "Checking the sources…"
msgstr "Quellen werden geprüft …"

msgid "Core"
msgstr "Core"

msgid "Core addresses, mempool, governance and block lists"
msgstr "Core-Adressen, Mempool, Governance und Blocklisten"

msgid "Core tip"
msgstr "Core-Spitze"

msgid "Core tip, blocks and transactions, straight from evonodes"
msgstr "Core-Spitze, Blöcke und Transaktionen, direkt von Evonodes"

msgid "DAPI"
msgstr "DAPI"

msgid "DAPI and the Platform SDK are answering. Hosted sources are off in Decentralized only mode."
msgstr "DAPI und das Platform SDK antworten. Gehostete Quellen sind im Modus „Nur dezentral“ aus."

msgid "DAPI is busy, so block lists come from Hyphen while the budget recovers. Details still use DAPI."
msgstr "DAPI ist ausgelastet, daher kommen Blocklisten von Hyphen, bis sich das Budget erholt. Details nutzen weiterhin DAPI."

msgid "DAPI isn’t answering, so block and transaction details come from Hyphen and say so."
msgstr "DAPI antwortet nicht, daher stammen Block- und Transaktionsdetails von Hyphen und sind entsprechend gekennzeichnet."

msgid "DAPI request budget"
msgstr "DAPI-Anfragebudget"

msgid "Dash Core"
msgstr "Dash Core"

msgid "Decentralized only mode doesn’t contact this source."
msgstr "Der Modus „Nur dezentral“ kontaktiert diese Quelle nicht."

msgid "Details"
msgstr "Details"

msgid "Every source is answering."
msgstr "Alle Quellen antworten."

msgid "Everything Core shows comes from DAPI."
msgstr "Alles, was Core zeigt, stammt von DAPI."

msgid "Figures computed on your device"
msgstr "Auf deinem Gerät berechnete Zahlen"

msgid "Getting tight"
msgstr "Wird knapp"

msgid "Headers and blocks"
msgstr "Header und Blöcke"

msgid "Headroom"
msgstr "Spielraum"

msgid "How each source is answering, and how far behind its data is."
msgstr "Wie jede Quelle antwortet und wie weit ihre Daten zurückliegen."

msgid "Hyphen"
msgstr "Hyphen"

msgid "Indexed to Core block {indexed} of {chain}. It calls its sync “{sync}”, but its index is behind the chain."
msgstr "Bis Core-Block {indexed} von {chain} indexiert. Hyphen nennt seine Synchronisierung „{sync}“, aber sein Index liegt hinter der Chain zurück."

msgid "Indexed to Core block {indexed} of {chain}. Sync: {sync}."
msgstr "Indiziert bis Core-Block {indexed} von {chain}. Synchronisierung: {sync}."

msgid "Indexed to Platform block {indexed} of {chain}. Indexer: {state}."
msgstr "Indiziert bis Platform-Block {indexed} von {chain}. Indexer: {state}."

msgid "Insight"
msgstr "Insight"

msgid "It answered with an error."
msgstr "Es hat mit einem Fehler geantwortet."

msgid "It hasn’t answered yet."
msgstr "Es hat noch nicht geantwortet."

msgid "It is rate limiting this browser."
msgstr "Es begrenzt die Anfragen dieses Browsers."

msgid "It sent an answer Radar can’t read."
msgstr "Es hat eine Antwort gesendet, die Radar nicht lesen kann."

msgid "It took too long to answer."
msgstr "Es hat zu lange für eine Antwort gebraucht."

msgid "Its data is behind."
msgstr "Seine Daten hinken hinterher."

msgid "Its tip is Core block {tip}, behind the chain."
msgstr "Sein Stand ist Core-Block {tip}, hinter der Chain."

msgid "Its tip is Core block {tip}."
msgstr "Sein Stand ist Core-Block {tip}."

#. placeholder {0}: formatRelative(clampSkew(finished, now), now)
#. placeholder {1}: formatInt(status.chain.blocks)
msgid "Last crawl finished {0}. Its Core node is at block {1}."
msgstr "Der letzte Crawl endete {0}. Sein Core-Knoten steht bei Block {1}."

#. placeholder {0}: ago(health.lastOkAt)
msgid "Last good {0}."
msgstr "Zuletzt in Ordnung {0}."

msgid "Median answer {rounded} ms"
msgstr "Mittlere Antwortzeit {rounded} ms"

msgid "Network internals: peers, mempool pressure, versions and history"
msgstr "Netzwerk-Interna: Peers, Mempool-Auslastung, Versionen und Verlauf"

msgid "No crawl has finished yet."
msgstr "Noch kein Crawl abgeschlossen."

msgid "No DAPI requests have been made on this network yet."
msgstr "In diesem Netzwerk wurden noch keine DAPI-Anfragen gestellt."

msgid "Node sync"
msgstr "Knotensynchronisierung"

msgid "Nodes resting"
msgstr "Ruhende Knoten"

msgid "Not available right now"
msgstr "Derzeit nicht verfügbar"

msgid "Not offered"
msgstr "Nicht angeboten"

msgid "Nothing has asked it yet on this network."
msgstr "In diesem Netzwerk hat sie noch niemand angefragt."

msgid "Off in this mode"
msgstr "In diesem Modus aus"

msgid "Platform Explorer"
msgstr "Platform Explorer"

msgid "Platform lists and counts"
msgstr "Platform-Listen und -Zähler"

msgid "Platform SDK"
msgstr "Platform SDK"

msgid "Plenty of room"
msgstr "Reichlich Spielraum"

msgid "Pressure"
msgstr "Auslastung"

msgid "Price feed"
msgstr "Preisfeed"

msgid "Proof-checked at Platform block {block}, epoch {epoch}. That block is {age}."
msgstr "Beweisgeprüft bei Platform-Block {block}, Epoche {epoch}. Dieser Block ist {age}."

msgid "Proof-checked Platform state, verified in this browser"
msgstr "Beweisgeprüfter Platform-Zustand, in diesem Browser verifiziert"

msgid "Radar crawler"
msgstr "Radar-Crawler"

msgid "Radar keeps each evonode well under its rate limit, so one visitor can’t crowd out another."
msgstr "Radar hält jeden Evonode weit unter seinem Ratenlimit, damit ein Besucher keinen anderen verdrängt."

msgid "Requests in the last minute"
msgstr "Anfragen in der letzten Minute"

msgid "Some requests are failing."
msgstr "Einige Anfragen schlagen fehl."

msgid "Some sources are slow or behind. The rest still work."
msgstr "Einige Quellen sind langsam oder hinken hinterher. Der Rest funktioniert weiterhin."

msgid "Some sources aren’t answering. The rest still work."
msgstr "Einige Quellen antworten nicht. Der Rest funktioniert weiterhin."

msgid "Sources"
msgstr "Quellen"

msgid "Status"
msgstr "Status"

msgid "Synced"
msgstr "Synchronisiert"

msgid "The connection failed."
msgstr "Die Verbindung ist fehlgeschlagen."

msgid "The masternode census and network history"
msgstr "Der Masternode-Zensus und der Netzwerkverlauf"

msgid "The median answer takes {seconds} s."
msgstr "Die mittlere Antwortzeit beträgt {seconds} s."

msgid "The request budget is nearly used."
msgstr "Das Anfragebudget ist fast aufgebraucht."

msgid "The USD rate, through Platform Explorer"
msgstr "Der USD-Kurs über Platform Explorer"

msgid "This browser"
msgstr "Dieser Browser"

msgid "This network doesn’t have this source."
msgstr "Dieses Netzwerk hat diese Quelle nicht."

msgid "Tip hash"
msgstr "Hash der Spitze"

msgid "Used up for now"
msgstr "Vorerst aufgebraucht"

msgid "What the evonodes report about the chain right now."
msgstr "Was die Evonodes gerade über die Chain melden."
