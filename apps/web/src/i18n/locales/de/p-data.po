msgid "“{field}” has more than one clause. Use one, or a lower and an upper bound."
msgstr "„{field}“ hat mehr als eine Bedingung. Nutze eine oder eine untere und eine obere Grenze."

msgid "“{field}” isn’t in any index of this type, so Platform can’t filter on it."
msgstr "„{field}“ steht in keinem Index dieses Typs, deshalb kann Platform danach nicht filtern."

msgid "“{field}” needs a clause on “{other}” first: index {index} is read in order, earlier properties before later ones."
msgstr "„{field}“ braucht zuerst eine Bedingung für „{other}“: Index {index} wird der Reihe nach gelesen, frühere Eigenschaften vor späteren."

msgid "“{field}” needs a value."
msgstr "„{field}“ braucht einen Wert."

msgid "“{field}” takes a whole number."
msgstr "„{field}“ erwartet eine ganze Zahl."

msgid "“{field}” takes an identifier: 32 bytes written in base58."
msgstr "„{field}“ erwartet eine Kennung: 32 Bytes in base58."

msgid "“{field}” takes true or false."
msgstr "„{field}“ erwartet true oder false."

msgid "“starts with” works on text, and “{field}” isn’t text."
msgstr "„beginnt mit“ gilt für Text, und „{field}“ ist kein Text."

