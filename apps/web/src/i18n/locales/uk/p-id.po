msgstr "Немає документів {type} від цієї ідентичності."

msgid "No identities match."
msgstr "Відповідних ідентичностей немає."

msgid "No identity holds this key hash."
msgstr "Жодна ідентичність не має цього хешу ключа."

msgid "No identity owns the name {name}."
msgstr "Жодна ідентичність не володіє іменем {name}."

msgid "No identity with this ID on {net}."
msgstr "У мережі {net} немає ідентичності з таким ID."

msgid "No keys of this identity are bound to that contract."
msgstr "Жоден ключ цієї ідентичності не прив’язаний до цього контракту."

msgid "No names"
msgstr "Немає імен"

msgid "No single identity owns this hash; these identities share it."
msgstr "Цей хеш не належить одній ідентичності; ним володіють кілька."

msgid "No tokens to check."
msgstr "Немає токенів для перевірки."

msgid "Nonce"
msgstr "Nonce"

msgid "None"
msgstr "Немає"

msgid "Not available"
msgstr "Недоступно"

msgid "Not frozen"
msgstr "Не заморожений"

msgid "Not indexed"
msgstr "Не проіндексовано"

msgid "Only masternode voting identities cast contested-resource votes, and Platform deletes a vote once the contest is decided."
msgstr "За спірні ресурси голосують лише голосуючі ідентичності мастернод, а Platform видаляє голос, щойно спір вирішено."

msgid "Only masternode voting identities vote, and Platform drops a vote once its contest is decided."
msgstr "Голосують лише голосуючі ідентичності мастернод, а Platform відкидає голос, щойно спір вирішено."

msgid "Open"
msgstr "Відкрити"

msgid "Open an identity"
msgstr "Відкрити ідентичність"

msgid "Opening the identity…"
msgstr "Відкриваємо ідентичність…"

msgid "Operator"
msgstr "Оператор"

msgid "Overview"
msgstr "Огляд"

msgid "Paste the HASH160 of a public key to find the identity that holds it."
msgstr "Вставте HASH160 відкритого ключа, щоб знайти ідентичність, якій він належить."

msgid "Platform"
msgstr "Platform"

msgid "Platform answers group membership only for the contracts it is asked about: the ones this identity owns, and the one you name."
msgstr "Platform відповідає про членство в групах лише для запитаних контрактів: тих, що належать цій ідентичності, і вказаного вами."

msgid "Platform Explorer has no tokens for this identity."
msgstr "У Platform Explorer немає токенів для цієї ідентичності."

msgid "Platform Explorer isn’t answering"
msgstr "Platform Explorer не відповідає"

msgid "Platform has no identity with this ID on this network."
msgstr "У цій мережі Platform немає ідентичності з таким ID."

msgid "Platform keeps no list of identities, so the list needs an indexer"
msgstr "Platform не веде список ідентичностей, тому для списку потрібен індексатор"

msgid "Position"
msgstr "Позиція"

msgid "Power"
msgstr "Вага"

msgid "Proof-checked balances for well-known tokens and any token ID you add."
msgstr "Баланси відомих токенів і будь-якого доданого вами ID токена, підтверджені доказом."

msgid "Public key hash"
msgstr "Хеш відкритого ключа"

msgid "Public keys"
msgstr "Відкриті ключі"

msgid "Purpose"
msgstr "Призначення"

msgid "Read-only"
msgstr "Лише читання"

msgid "Regular"
msgstr "Звичайна"

