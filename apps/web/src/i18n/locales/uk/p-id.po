msgid "Enter a contract ID to see its nonce and keys."
msgstr "Введіть ID контракту, щоб побачити його nonce і ключі."

msgid "Enter a public key hash: 40 hexadecimal characters."
msgstr "Введіть хеш відкритого ключа: 40 шістнадцяткових символів."

msgid "Enter an identity ID or a name such as alice.dash."
msgstr "Введіть ID ідентичності або ім’я на кшталт alice.dash."

msgid "Every identity Platform Explorer has indexed, with its balance and activity."
msgstr "Усі ідентичності, проіндексовані Platform Explorer, з балансом і активністю."

msgid "Filter"
msgstr "Фільтр"

