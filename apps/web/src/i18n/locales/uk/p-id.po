msgstr "Рівень безпеки"

#. placeholder {0}: formatInt(NAMES_LIMIT)
msgid "Showing the first {0} names."
msgstr "Показано перші {0} імен."

msgid "State"
msgstr "Стан"

msgid "Summary"
msgstr "Підсумок"

msgid "That is every match."
msgstr "Це всі збіги."

msgid "That isn’t a contract ID: it is 43 or 44 base58 characters."
msgstr "Це не ID контракту: він складається з 43 або 44 символів base58."

msgid "That isn’t a token ID: it is 43 or 44 base58 characters."
msgstr "Це не ID токена: він складається з 43 або 44 символів base58."

msgid "That isn’t an identity ID."
msgstr "Це не ID ідентичності."

msgid "The contracts this identity created need an indexer"
msgstr "Для контрактів, створених цією ідентичністю, потрібен індексатор"

msgid "The dates narrow the identities on the page being shown."
msgstr "Дати звужують список ідентичностей на показаній сторінці."

msgid "The funding transaction needs an indexer"
msgstr "Для транзакції поповнення потрібен індексатор"

msgid "The name couldn’t be looked up right now."
msgstr "Зараз не вдалося знайти ім’я."

msgid "The tokens Platform Explorer has indexed for this identity need an indexer"
msgstr "Для токенів, які Platform Explorer проіндексував для цієї ідентичності, потрібен індексатор"

msgid "This identity has created no contracts."
msgstr "Ця ідентичність не створювала контрактів."

msgid "This identity has created no documents."
msgstr "Ця ідентичність не створювала документів."

msgid "This identity has made no credit transfers."
msgstr "Ця ідентичність не робила переказів кредитів."

msgid "This identity has no keys."
msgstr "У цієї ідентичності немає ключів."

msgid "This identity has no votes on record."
msgstr "У цієї ідентичності немає записаних голосів."

msgid "This identity has sent no transitions."
msgstr "Ця ідентичність не надсилала переходів."

msgid "This identity is not a member of any group in those contracts."
msgstr "Ця ідентичність не входить до жодної групи в цих контрактах."

msgid "This identity owns no names."
msgstr "Ця ідентичність не володіє іменами."

msgid "This identity’s credit transfers need an indexer"
msgstr "Для переказів кредитів цієї ідентичності потрібен індексатор"

msgid "This identity’s documents need an indexer"
msgstr "Для документів цієї ідентичності потрібен індексатор"

msgid "This identity’s nonce for a contract and the keys bound to it."
msgstr "Nonce цієї ідентичності для контракту та прив’язані до нього ключі."

msgid "This identity’s transitions need an indexer"
msgstr "Для переходів цієї ідентичності потрібен індексатор"

