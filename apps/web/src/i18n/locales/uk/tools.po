msgid "Up to {MAX_STATEMENTS} statements run at once; this has {0}."
msgstr "За раз виконується до {MAX_STATEMENTS} інструкцій; тут їх {0}."

msgid "Use == for an exact match. LIKE is only a prefix match here."
msgstr "Використовуйте == для точного збігу. LIKE тут — лише збіг за префіксом."

msgid "Use ==, >, >=, <, <=, BETWEEN … AND …, IN (…) or STARTS WITH."
msgstr "Використовуйте ==, >, >=, <, <=, BETWEEN … AND …, IN (…) або STARTS WITH."

msgid "Value"
msgstr "Значення"

msgid "Vote"
msgstr "Голос"

msgid "Voting state"
msgstr "Стан голосування"

msgid "What the proof contains"
msgstr "Що містить доказ"

msgid "Which Platform SDK call backs each Radar page, with its arguments."
msgstr "Який виклик SDK Platform забезпечує кожну сторінку Radar, з аргументами."

msgid "Write a literal prefix and one trailing %, as in LIKE 'abc%', or use STARTS WITH for a prefix that holds % or _."
msgstr "Напишіть буквальний префікс і один % наприкінці, як у LIKE 'abc%', або використовуйте STARTS WITH для префікса, що містить % або _."

msgid "Write a query to run."
msgstr "Напишіть запит для виконання."

msgid "Write text between single quotes, and write a quote inside the text twice."
msgstr "Пишіть текст в одинарних лапках, а лапку всередині тексту подвоюйте."

msgid "Write text values, including IDs, in single quotes."
msgstr "Текстові значення, зокрема ID, пишіть в одинарних лапках."

msgid "You can keep up to 20 queries here. Delete one first."
msgstr "Тут можна зберігати до 20 запитів. Спочатку видаліть один."

msgid "Your browser"
msgstr "Ваш браузер"
