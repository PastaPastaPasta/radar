msgstr "Radar тримає числа в межах точного діапазону JavaScript. Для більшого точного значення використовуйте SDK безпосередньо."

msgid "Raw reading"
msgstr "Вихідний розбір"

msgid "Raw result"
msgstr "Необроблений результат"

msgid "Read as"
msgstr "Прочитати як"

