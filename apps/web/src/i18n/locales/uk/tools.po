msgid "“{arg}” has no wildcard."
msgstr "У “{arg}” немає підстановного знака."

msgid "“{arg}” isn't a number."
msgstr "“{arg}” — не число."

msgid "“{arg}” isn't an operator Platform knows."
msgstr "“{arg}” — не оператор, відомий Platform."

msgid "“{arg}” isn't supported here."
msgstr "“{arg}” тут не підтримується."

msgid "“{arg}” isn't supported."
msgstr "“{arg}” не підтримується."

msgid "“{arg}” needs quotes."
msgstr "“{arg}” потрібно взяти в лапки."

