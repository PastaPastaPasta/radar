msgid "LIKE needs a quoted pattern such as 'abc%'."
msgstr "LIKE потребує шаблон у лапках, наприклад 'abc%'."

msgid "LIMIT must be between 1 and 100."
msgstr "LIMIT має бути від 1 до 100."

