msgid "Reachable nodes counted per city, never by address, and how many have no location."
msgstr "Досяжні вузли, підраховані за містами (ніколи за адресами), і скільки з них без розташування."

msgid "Registered"
msgstr "Зареєстровано"

msgid "Registrations and removals"
msgstr "Реєстрації та вилучення"

msgid "Same location"
msgstr "Те саме місце"

msgid "Search masternodes"
msgstr "Пошук мастернод"

msgid "Search ProTx, IP, city, hosting"
msgstr "Пошук за ProTx, IP, містом, хостингом"

