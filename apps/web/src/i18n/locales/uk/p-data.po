msgid "—"
msgstr "—"

msgid "“{field}” has more than one clause. Use one, or a lower and an upper bound."
msgstr "У «{field}» більше однієї умови. Залиште одну або задайте нижню й верхню межі."

msgid "“{field}” isn’t in any index of this type, so Platform can’t filter on it."
msgstr "«{field}» немає в жодному індексі цього типу, тому Platform не може за ним фільтрувати."

msgid "“{field}” needs a clause on “{other}” first: index {index} is read in order, earlier properties before later ones."
msgstr "Для «{field}» спершу потрібна умова щодо «{other}»: індекс {index} читається по порядку, спочатку ранні властивості."

msgid "“{field}” needs a value."
msgstr "Для «{field}» потрібне значення."

msgid "“{field}” takes a whole number."
msgstr "«{field}» приймає ціле число."

msgid "“{field}” takes an identifier: 32 bytes written in base58."
msgstr "«{field}» приймає ідентифікатор: 32 байти у форматі base58."

msgid "“{field}” takes true or false."
msgstr "«{field}» приймає true або false."

msgid "“starts with” works on text, and “{field}” isn’t text."
msgstr "«починається з» працює з текстом, а «{field}» — не текст."

msgid "{changeCount, plural, one {# change} other {# changes}}"
msgstr "{changeCount, plural, one {# зміна} few {# зміни} many {# змін} other {# зміни}}"

msgid "{count, plural, one {# signer} other {# signers}}"
msgstr "{count, plural, one {# підписант} few {# підписанти} many {# підписантів} other {# підписанта}}"

