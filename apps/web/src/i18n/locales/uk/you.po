msgid "{count, plural, one {# DAPI address} other {# DAPI addresses}}"
msgstr "{count, plural, one {# адреса DAPI} few {# адреси DAPI} many {# адрес DAPI} other {# адреси DAPI}}"

msgid "Add a devnet"
msgstr "Додати devnet"

msgid "Add devnet"
msgstr "Додати devnet"

msgid "Amounts"
msgstr "Суми"

msgid "Amounts show in {unitName}."
msgstr "Суми показуються в {unitName}."

msgid "Amounts show in {unitName}. Choose USD to lead with the dollar value."
msgstr "Суми показуються в {unitName}. Виберіть USD, щоб спершу показувати суму в доларах."

msgid "Cancel"
msgstr "Скасувати"

msgid "Custom devnets"
msgstr "Користувацькі devnet"

msgid "DAPI addresses"
msgstr "Адреси DAPI"

msgid "Devnet name"
msgstr "Назва devnet"

msgid "Edit"
msgstr "Редагувати"

msgid "Edit {editName}"
msgstr "Редагувати {editName}"

msgid "Enter at least one DAPI address as host:port, one per line."
msgstr "Введіть принаймні одну адресу DAPI у форматі хост:порт, по одній у рядку."

msgid "Example"
msgstr "Приклад"

msgid "Language"
msgstr "Мова"

msgid "No devnets saved."
msgstr "Збережених devnet немає."

msgid "Open"
msgstr "Відкрити"

msgid "optional"
msgstr "необов’язково"

msgid "Otherwise times follow this device’s time zone. Hovering a time always shows UTC."
msgstr "Інакше час відображається за часовим поясом цього пристрою. Під час наведення на час завжди показується UTC."

msgid "Quorum list URL"
msgstr "URL списку кворумів"

#. placeholder {0}: formatFiat(DUFFS_PER_DASH, rate.data.data.usd)
#. placeholder {1}: rate.data.data.provider
msgid "Rate: {0} per DASH, from {1}."
msgstr "Курс: {0} за DASH, джерело — {1}."

msgid "Remove"
msgstr "Видалити"

msgid "Remove {devnet}"
msgstr "Видалити {devnet}"

msgid "Save changes"
msgstr "Зберегти зміни"

msgid "Saved devnets"
msgstr "Збережені devnet"

msgid "Saved in this browser. A devnet with a name Radar doesn’t know asks for its addresses."
msgstr "Збережено в цьому браузері. Для devnet із невідомою Radar назвою потрібні його адреси."

msgid "See every source"
msgstr "Переглянути всі джерела"

msgid "Settings"
msgstr "Налаштування"

msgid "Show the USD value next to DASH amounts"
msgstr "Показувати вартість у USD поруч із сумами в DASH"

msgid "Show times in UTC"
msgstr "Показувати час у UTC"

msgid "Sources"
msgstr "Джерела"

msgid "Test coins have no value, so Testnet and devnets never show USD."
msgstr "Тестові монети не мають вартості, тому в тестовій мережі та devnet USD не показується."

msgid "Text that isn’t translated yet appears in English. Hashes, IDs and amounts are never translated."
msgstr "Текст, який ще не перекладено, відображається англійською. Хеші, ID і суми ніколи не перекладаються."

msgid "The quorum list URL must start with https://."
msgstr "URL списку кворумів має починатися з https://."

msgid "These choices stay in this browser. Radar never sends them anywhere."
msgstr "Ці налаштування зберігаються в цьому браузері. Radar ніколи нікуди їх не надсилає."

msgid "Times"
msgstr "Час"

msgid "Unit for amounts"
msgstr "Одиниця для сум"

msgid "USD comes first, with the DASH figure after it once the rate is in."
msgstr "Спершу показується USD, а потім сума в DASH, коли курс отримано."

msgid "USD is for mainnet only: test coins have no value."
msgstr "USD доступний лише в mainnet: тестові монети нічого не варті."

msgid "USD is rounded to three significant figures and follows the amount in {unitName}."
msgstr "USD округлюється до трьох значущих цифр і слідує за сумою в {unitName}."

msgid "USD is rounded to three significant figures. This choice doesn’t apply while USD comes first."
msgstr "USD округлюється до трьох значущих цифр. Цей вибір не діє, поки USD показується першим."

msgid "Use lowercase letters, digits and hyphens, for example \"ruby\"."
msgstr "Використовуйте малі літери, цифри та дефіси, наприклад «ruby»."

msgid "You"
msgstr "Ви"
