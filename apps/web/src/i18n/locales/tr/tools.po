msgstr "Yukarıdan bir sözleşme seçin veya türden önce adını yazın, örneğin FROM dpns.domain."

msgid "Pick a type"
msgstr "Bir tür seçin"

msgid "Platform address funding"
msgstr "Platform adresi yükleme"

