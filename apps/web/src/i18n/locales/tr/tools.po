msgid "Up to {MAX_STATEMENTS} statements run at once; this has {0}."
msgstr "Aynı anda en fazla {MAX_STATEMENTS} ifade çalışır; bunda {0} var."

msgid "Use == for an exact match. LIKE is only a prefix match here."
msgstr "Tam eşleşme için == kullanın. LIKE burada yalnızca önek eşleşmesidir."

msgid "Use ==, >, >=, <, <=, BETWEEN … AND …, IN (…) or STARTS WITH."
msgstr "==, >, >=, <, <=, BETWEEN … AND …, IN (…) veya STARTS WITH kullanın."

msgid "Value"
msgstr "Değer"

msgid "Vote"
msgstr "Oy"

msgid "Voting state"
msgstr "Oylama durumu"

msgid "What the proof contains"
msgstr "Kanıtın içeriği"

msgid "Which Platform SDK call backs each Radar page, with its arguments."
msgstr "Hangi Platform SDK çağrısının hangi Radar sayfasını beslediği, argümanlarıyla."

msgid "Write a literal prefix and one trailing %, as in LIKE 'abc%', or use STARTS WITH for a prefix that holds % or _."
msgstr "LIKE 'abc%' gibi düz bir önek ve sonunda tek bir % yazın; % veya _ içeren bir önek için STARTS WITH kullanın."

msgid "Write a query to run."
msgstr "Çalıştırılacak bir sorgu yazın."

msgid "Write text between single quotes, and write a quote inside the text twice."
msgstr "Metni tek tırnak arasına yazın; metnin içindeki tırnağı iki kez yazın."

msgid "Write text values, including IDs, in single quotes."
msgstr "Kimlikler dahil metin değerlerini tek tırnak içinde yazın."

msgid "You can keep up to 20 queries here. Delete one first."
msgstr "Burada en fazla 20 sorgu tutabilirsiniz. Önce birini silin."

msgid "Your browser"
msgstr "Tarayıcınız"
