msgstr "Hiçbir şey gönderilmedi."

msgid "Numbers are whole or decimal digits with an optional minus sign. Write IDs and other text in single quotes."
msgstr "Sayılar, isteğe bağlı eksi işaretli tam veya ondalık rakamlardır. Kimlikleri ve diğer metinleri tek tırnak içinde yazın."

msgid "One hex key per line."
msgstr "Satır başına bir hex anahtar."

msgid "One hex segment per line, from the root. Empty reads the root tree."
msgstr "Satır başına bir hex segment, kökten başlayarak. Boş bırakılırsa kök ağaç okunur."

msgid "Only prefix patterns work with LIKE."
msgstr "LIKE ile yalnızca önek kalıpları çalışır."

msgid "Only SELECT *, COUNT(*), SUM(field) and AVG(field) are supported."
msgstr "Yalnızca SELECT *, COUNT(*), SUM(field) ve AVG(field) desteklenir."

msgid "Operations in this batch"
msgstr "Bu toplu işlemdeki operasyonlar"

msgid "OR isn't supported."
msgstr "OR desteklenmiyor."

