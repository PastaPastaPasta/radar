msgstr "{signerCount}, gereken {requiredPower} ağırlığın {signedPower} kadarı"

msgid "A contract can hold only tokens or groups."
msgstr "Bir sözleşme yalnızca token’lar ya da yalnızca gruplar içerebilir."

msgid "A contract ID"
msgstr "Bir sözleşme kimliği"

msgid "A contract ID is 44 base58 characters or fewer."
msgstr "Bir sözleşme kimliği en fazla 44 base58 karakterdir."

msgid "A group lists identities and the power each holds; a decision needs enough power to reach the group’s threshold."
msgstr "Bir grup, kimlikleri ve her birinin ağırlığını listeler; bir karar için ağırlığın grubun eşiğine ulaşması gerekir."

msgid "A query can have only one “in” clause."
msgstr "Bir sorguda yalnızca bir “in” koşulu olabilir."

msgid "A range (<, ≤, >, ≥, starts with) on “{field}” must be on the last property you filter on in index {index}, but “{other}” comes after it."
msgstr "“{field}” üzerindeki bir aralık (<, ≤, >, ≥, ile başlar), {index} dizininde süzdüğünüz son özellikte olmalı; ama “{other}” ondan sonra geliyor."

