msgid "“{field}” has more than one clause. Use one, or a lower and an upper bound."
msgstr "“{field}” için birden fazla koşul var. Birini kullanın ya da bir alt ve bir üst sınır verin."

msgid "“{field}” isn’t in any index of this type, so Platform can’t filter on it."
msgstr "“{field}” bu türün hiçbir dizininde yok, bu yüzden Platform ona göre süzemez."

msgid "“{field}” needs a clause on “{other}” first: index {index} is read in order, earlier properties before later ones."
msgstr "“{field}” için önce “{other}” üzerinde bir koşul gerekir: {index} dizini sırayla okunur, önceki özellikler sonrakilerden önce gelir."

msgid "“{field}” needs a value."
msgstr "“{field}” için bir değer gerekir."

msgid "“{field}” takes a whole number."
msgstr "“{field}” bir tam sayı alır."

msgid "“{field}” takes an identifier: 32 bytes written in base58."
msgstr "“{field}” bir tanımlayıcı alır: base58 ile yazılmış 32 bayt."

msgid "“{field}” takes true or false."
msgstr "“{field}” true veya false alır."

msgid "“starts with” works on text, and “{field}” isn’t text."
msgstr "“ile başlar” metinler için çalışır ve “{field}” metin değildir."

