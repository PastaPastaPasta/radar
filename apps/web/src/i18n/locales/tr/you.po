msgid "Saved in this browser. A devnet with a name Radar doesn’t know asks for its addresses."
msgstr "Bu tarayıcıda kayıtlıdır. Radar’ın tanımadığı adlı bir devnet için adresleri istenir."

msgid "Saved item"
msgstr "Kayıtlı öğe"

msgid "Saved items"
msgstr "Kayıtlı öğeler"

msgid "Saved items cleared"
msgstr "Kayıtlı öğeler temizlendi"

msgid "SDK default"
msgstr "SDK varsayılanı"

