msgid "{count, plural, one {# DAPI address} other {# DAPI addresses}}"
msgstr "{count, plural, one {# DAPI adresi} other {# DAPI adresi}}"

msgid "Add a devnet"
msgstr "Devnet ekle"

msgid "Add devnet"
msgstr "Devnet ekle"

msgid "Amounts"
msgstr "Tutarlar"

msgid "Amounts show in {unitName}."
msgstr "Tutarlar {unitName} cinsinden gösterilir."

msgid "Amounts show in {unitName}. Choose USD to lead with the dollar value."
msgstr "Tutarlar {unitName} cinsinden gösterilir. Dolar değerinin önce gelmesi için USD’yi seçin."

msgid "Cancel"
msgstr "İptal"

msgid "Custom devnets"
msgstr "Özel devnet’ler"

msgid "DAPI addresses"
msgstr "DAPI adresleri"

msgid "Devnet name"
msgstr "Devnet adı"

msgid "Edit"
msgstr "Düzenle"

msgid "Edit {editName}"
msgstr "{editName} düzenle"

msgid "Enter at least one DAPI address as host:port, one per line."
msgstr "En az bir DAPI adresini host:port biçiminde, her satıra bir tane olacak şekilde girin."

msgid "Example"
msgstr "Örnek"

msgid "Language"
msgstr "Dil"

msgid "No devnets saved."
msgstr "Kayıtlı devnet yok."

msgid "Open"
msgstr "Aç"

msgid "optional"
msgstr "isteğe bağlı"

msgid "Otherwise times follow this device’s time zone. Hovering a time always shows UTC."
msgstr "Aksi halde saatler bu cihazın saat dilimine göre gösterilir. Bir saatin üzerine gelindiğinde her zaman UTC gösterilir."

msgid "Quorum list URL"
msgstr "Quorum listesi URL’si"

#. placeholder {0}: formatFiat(DUFFS_PER_DASH, rate.data.data.usd)
#. placeholder {1}: rate.data.data.provider
msgid "Rate: {0} per DASH, from {1}."
msgstr "Kur: DASH başına {0}, kaynak {1}."

msgid "Remove"
msgstr "Kaldır"

msgid "Remove {devnet}"
msgstr "{devnet} kaldır"

msgid "Save changes"
msgstr "Değişiklikleri kaydet"

msgid "Saved devnets"
msgstr "Kayıtlı devnet’ler"

msgid "Saved in this browser. A devnet with a name Radar doesn’t know asks for its addresses."
msgstr "Bu tarayıcıda kayıtlıdır. Radar’ın tanımadığı adlı bir devnet için adresleri istenir."

msgid "See every source"
msgstr "Tüm kaynakları gör"

msgid "Settings"
msgstr "Ayarlar"

msgid "Show the USD value next to DASH amounts"
msgstr "DASH tutarlarının yanında USD değerini göster"

msgid "Show times in UTC"
msgstr "Saatleri UTC olarak göster"

msgid "Sources"
msgstr "Kaynaklar"

msgid "Test coins have no value, so Testnet and devnets never show USD."
msgstr "Test coin’lerin değeri yoktur; bu yüzden Testnet ve devnet’lerde USD hiç gösterilmez."

msgid "Text that isn’t translated yet appears in English. Hashes, IDs and amounts are never translated."
msgstr "Henüz çevrilmemiş metinler İngilizce görünür. Hash’ler, kimlik numaraları ve tutarlar asla çevrilmez."

msgid "The quorum list URL must start with https://."
msgstr "Quorum listesi URL’si https:// ile başlamalıdır."

msgid "These choices stay in this browser. Radar never sends them anywhere."
msgstr "Bu tercihler bu tarayıcıda kalır. Radar bunları hiçbir yere göndermez."

msgid "Times"
msgstr "Zamanlar"

msgid "Unit for amounts"
msgstr "Tutarlar için birim"

msgid "USD comes first, with the DASH figure after it once the rate is in."
msgstr "Önce USD gelir, kur geldiğinde ardından DASH değeri gösterilir."

msgid "USD is for mainnet only: test coins have no value."
msgstr "USD yalnızca mainnet için geçerlidir: test coinlerinin değeri yoktur."

msgid "USD is rounded to three significant figures and follows the amount in {unitName}."
msgstr "USD üç anlamlı basamağa yuvarlanır ve {unitName} cinsinden tutarı izler."

msgid "USD is rounded to three significant figures. This choice doesn’t apply while USD comes first."
msgstr "USD üç anlamlı basamağa yuvarlanır. USD önce gösterildiği sürece bu seçim geçerli değildir."

msgid "Use lowercase letters, digits and hyphens, for example \"ruby\"."
msgstr "Küçük harf, rakam ve tire kullanın, örneğin “ruby”."

msgid "You"
msgstr "Siz"
