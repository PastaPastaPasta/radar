msgid "“{field}” has more than one clause. Use one, or a lower and an upper bound."
msgstr "“{field}” tiene más de una cláusula. Usa una, o un límite inferior y uno superior."

msgid "“{field}” isn’t in any index of this type, so Platform can’t filter on it."
msgstr "“{field}” no está en ningún índice de este tipo, así que Platform no puede filtrar por él."

msgid "“{field}” needs a clause on “{other}” first: index {index} is read in order, earlier properties before later ones."
msgstr "“{field}” necesita antes una cláusula sobre “{other}”: el índice {index} se lee en orden, las propiedades anteriores antes que las posteriores."

msgid "“{field}” needs a value."
msgstr "“{field}” necesita un valor."

msgid "“{field}” takes a whole number."
msgstr "“{field}” admite un número entero."

msgid "“{field}” takes an identifier: 32 bytes written in base58."
msgstr "“{field}” admite un identificador: 32 bytes escritos en base58."

msgid "“{field}” takes true or false."
msgstr "“{field}” admite true o false."

msgid "“starts with” works on text, and “{field}” isn’t text."
msgstr "“empieza por” funciona con texto, y “{field}” no es texto."

msgid "{changeCount, plural, one {# change} other {# changes}}"
msgstr "{changeCount, plural, one {# cambio} other {# cambios}}"

msgid "{count, plural, one {# signer} other {# signers}}"
msgstr "{count, plural, one {# firmante} other {# firmantes}}"

