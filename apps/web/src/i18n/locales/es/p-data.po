msgstr "{pinnedOrderField}, ascendente"

msgid "{pinnedOrderField}, descending"
msgstr "{pinnedOrderField}, descendente"

msgid "{props} properties · {indices} indices"
msgstr "{props} propiedades · {indices} índices"

msgid "{signerCount}, power {signedPower} of {requiredPower} required"
msgstr "{signerCount}, peso {signedPower} de {requiredPower} requerido"

msgid "A contract can hold only tokens or groups."
msgstr "Un contrato solo puede contener tokens o grupos."

msgid "A contract ID"
msgstr "Un ID de contrato"

msgid "A contract ID is 44 base58 characters or fewer."
msgstr "Un ID de contrato tiene como máximo 44 caracteres base58."

msgid "A group lists identities and the power each holds; a decision needs enough power to reach the group’s threshold."
msgstr "Un grupo enumera identidades y el peso de cada una; una decisión necesita peso suficiente para alcanzar el umbral del grupo."

msgid "A query can have only one “in” clause."
msgstr "Una consulta solo puede tener una cláusula “in”."

msgid "A range (<, ≤, >, ≥, starts with) on “{field}” must be on the last property you filter on in index {index}, but “{other}” comes after it."
msgstr "Un rango (<, ≤, >, ≥, empieza por) sobre “{field}” debe ir en la última propiedad que filtras del índice {index}, pero “{other}” viene después."

