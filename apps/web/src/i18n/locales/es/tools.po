msgstr "Se ejecutan hasta {MAX_STATEMENTS} sentencias a la vez; esta tiene {0}."

msgid "Use == for an exact match. LIKE is only a prefix match here."
msgstr "Usa == para una coincidencia exacta. LIKE aquí es solo una coincidencia de prefijo."

msgid "Use ==, >, >=, <, <=, BETWEEN … AND …, IN (…) or STARTS WITH."
msgstr "Usa ==, >, >=, <, <=, BETWEEN … AND …, IN (…) o STARTS WITH."

msgid "Value"
msgstr "Valor"

msgid "Vote"
msgstr "Voto"

msgid "Voting state"
msgstr "Estado de votación"

msgid "What the proof contains"
msgstr "Qué contiene la prueba"

msgid "Which Platform SDK call backs each Radar page, with its arguments."
msgstr "Qué llamada del SDK de Platform respalda cada página de Radar, con sus argumentos."

msgid "Write a literal prefix and one trailing %, as in LIKE 'abc%', or use STARTS WITH for a prefix that holds % or _."
msgstr "Escribe un prefijo literal y un solo % al final, como en LIKE 'abc%', o usa STARTS WITH para un prefijo que contenga % o _."

msgid "Write a query to run."
msgstr "Escribe una consulta para ejecutar."

msgid "Write text between single quotes, and write a quote inside the text twice."
msgstr "Escribe el texto entre comillas simples y duplica una comilla dentro del texto."

msgid "Write text values, including IDs, in single quotes."
msgstr "Escribe los valores de texto, incluidos los ID, entre comillas simples."

msgid "You can keep up to 20 queries here. Delete one first."
msgstr "Aquí puedes guardar hasta 20 consultas. Elimina una primero."

msgid "Your browser"
msgstr "Tu navegador"
