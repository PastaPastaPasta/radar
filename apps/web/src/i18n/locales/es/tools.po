msgid "Numbers are whole or decimal digits with an optional minus sign. Write IDs and other text in single quotes."
msgstr "Los números son dígitos enteros o decimales con un signo menos opcional. Escribe los ID y el resto del texto entre comillas simples."

msgid "One hex key per line."
msgstr "Una clave hex por línea."

msgid "One hex segment per line, from the root. Empty reads the root tree."
msgstr "Un segmento hex por línea, desde la raíz. Vacío lee el árbol raíz."

msgid "Only prefix patterns work with LIKE."
msgstr "Con LIKE solo funcionan los patrones de prefijo."

msgid "Only SELECT *, COUNT(*), SUM(field) and AVG(field) are supported."
msgstr "Solo se admiten SELECT *, COUNT(*), SUM(campo) y AVG(campo)."

