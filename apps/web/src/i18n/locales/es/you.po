msgid "{count, plural, one {# DAPI address} other {# DAPI addresses}}"
msgstr "{count, plural, one {# dirección DAPI} many {# de direcciones DAPI} other {# direcciones DAPI}}"

msgid "Add a devnet"
msgstr "Añadir una devnet"

msgid "Add devnet"
msgstr "Añadir devnet"

msgid "Amounts"
msgstr "Importes"

msgid "Amounts show in {unitName}."
msgstr "Los importes se muestran en {unitName}."

msgid "Amounts show in {unitName}. Choose USD to lead with the dollar value."
msgstr "Los importes se muestran en {unitName}. Elige USD para que el valor en dólares vaya primero."

msgid "Cancel"
msgstr "Cancelar"

msgid "Custom devnets"
msgstr "Devnets personalizadas"

msgid "DAPI addresses"
msgstr "Direcciones DAPI"

msgid "Devnet name"
msgstr "Nombre de la devnet"

msgid "Edit"
msgstr "Editar"

msgid "Edit {editName}"
msgstr "Editar {editName}"

msgid "Enter at least one DAPI address as host:port, one per line."
msgstr "Introduce al menos una dirección DAPI como host:puerto, una por línea."

msgid "Example"
msgstr "Ejemplo"

msgid "Language"
msgstr "Idioma"

msgid "No devnets saved."
msgstr "No hay devnets guardadas."

msgid "Open"
msgstr "Abrir"

msgid "optional"
msgstr "opcional"

msgid "Otherwise times follow this device’s time zone. Hovering a time always shows UTC."
msgstr "De lo contrario, las horas siguen la zona horaria de este dispositivo. Al pasar el cursor sobre una hora siempre se muestra UTC."

msgid "Quorum list URL"
msgstr "URL de la lista de quórums"

#. placeholder {0}: formatFiat(DUFFS_PER_DASH, rate.data.data.usd)
#. placeholder {1}: rate.data.data.provider
msgid "Rate: {0} per DASH, from {1}."
msgstr "Tasa: {0} por DASH, de {1}."

msgid "Remove"
msgstr "Quitar"

msgid "Remove {devnet}"
msgstr "Quitar {devnet}"

msgid "Save changes"
msgstr "Guardar cambios"

msgid "Saved devnets"
msgstr "Devnets guardadas"

msgid "Saved in this browser. A devnet with a name Radar doesn’t know asks for its addresses."
msgstr "Guardado en este navegador. Una devnet con un nombre que Radar no conoce pide sus direcciones."

msgid "See every source"
msgstr "Ver todas las fuentes"

msgid "Settings"
msgstr "Ajustes"

msgid "Show the USD value next to DASH amounts"
msgstr "Mostrar el valor en USD junto a los importes en DASH"

msgid "Show times in UTC"
msgstr "Mostrar las horas en UTC"

msgid "Sources"
msgstr "Fuentes"

msgid "Test coins have no value, so Testnet and devnets never show USD."
msgstr "Las monedas de prueba no tienen valor, así que la testnet y las devnets nunca muestran USD."

msgid "Text that isn’t translated yet appears in English. Hashes, IDs and amounts are never translated."
msgstr "El texto que aún no está traducido aparece en inglés. Los hashes, los ID y los importes nunca se traducen."

msgid "The quorum list URL must start with https://."
msgstr "La URL de la lista de quórums debe empezar por https://."

msgid "These choices stay in this browser. Radar never sends them anywhere."
msgstr "Estas opciones se quedan en este navegador. Radar nunca las envía a ninguna parte."

msgid "Times"
msgstr "Horas"

msgid "Unit for amounts"
msgstr "Unidad de los importes"

msgid "USD comes first, with the DASH figure after it once the rate is in."
msgstr "USD va primero y la cifra en DASH le sigue en cuanto llega la tasa."

msgid "USD is for mainnet only: test coins have no value."
msgstr "USD solo está disponible en mainnet: las monedas de prueba no tienen valor."

msgid "USD is rounded to three significant figures and follows the amount in {unitName}."
msgstr "USD se redondea a tres cifras significativas y sigue al importe en {unitName}."

msgid "USD is rounded to three significant figures. This choice doesn’t apply while USD comes first."
msgstr "USD se redondea a tres cifras significativas. Esta opción no se aplica mientras USD va primero."

msgid "Use lowercase letters, digits and hyphens, for example \"ruby\"."
msgstr "Usa letras minúsculas, dígitos y guiones, por ejemplo “ruby”."

msgid "You"
msgstr "Tú"
