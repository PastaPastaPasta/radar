msgid "—"
msgstr "—"

msgid "“{field}” has more than one clause. Use one, or a lower and an upper bound."
msgstr "「{field}」に複数の条件があります。1 つにするか、下限と上限を 1 つずつ指定してください。"

msgid "“{field}” isn’t in any index of this type, so Platform can’t filter on it."
msgstr "「{field}」はこの種類のどのインデックスにも含まれていないため、Platform は絞り込めません。"

msgid "“{field}” needs a clause on “{other}” first: index {index} is read in order, earlier properties before later ones."
msgstr "「{field}」の前に「{other}」の条件が必要です。インデックス {index} は順番に読まれ、前のプロパティが先になります。"

msgid "“{field}” needs a value."
msgstr "「{field}」には値が必要です。"

msgid "“{field}” takes a whole number."
msgstr "「{field}」には整数を指定してください。"

msgid "“{field}” takes an identifier: 32 bytes written in base58."
msgstr "「{field}」には識別子（base58 で表した 32 バイト）を指定してください。"

msgid "“{field}” takes true or false."
msgstr "「{field}」には true か false を指定してください。"

msgid "“starts with” works on text, and “{field}” isn’t text."
msgstr "「で始まる」はテキストに使えますが、「{field}」はテキストではありません。"

msgid "{changeCount, plural, one {# change} other {# changes}}"
msgstr "{changeCount, plural, other {# 件の変更}}"

msgid "{count, plural, one {# signer} other {# signers}}"
msgstr "{count, plural, other {署名者 # 人}}"

msgid "{f}, ascending"
msgstr "{f}、昇順"

msgid "{f}, descending"
msgstr "{f}、降順"

msgid "{field}: searching “{searched}” for “{typed}” (DPNS stores o, i and l as 0, 1 and 1)"
msgstr "{field}: 「{typed}」を「{searched}」として検索しています（DPNS は o、i、l を 0、1、1 として保存します）"

msgid "{pinnedOrderField}, ascending"
msgstr "{pinnedOrderField}、昇順"

msgid "{pinnedOrderField}, descending"
msgstr "{pinnedOrderField}、降順"

msgid "{props} properties · {indices} indices"
msgstr "{props} 個のプロパティ · {indices} 個のインデックス"

msgid "{signerCount}, power {signedPower} of {requiredPower} required"
msgstr "{signerCount}、必要な重み {requiredPower} のうち {signedPower}"

msgid "A contract can hold only tokens or groups."
msgstr "コントラクトに含められるのはトークンかグループのどちらか一方だけです。"

msgid "A contract ID"
msgstr "コントラクト ID"

msgid "A contract ID is 44 base58 characters or fewer."
msgstr "コントラクト ID は base58 で 44 文字以内です。"

msgid "A group lists identities and the power each holds; a decision needs enough power to reach the group’s threshold."
msgstr "グループはアイデンティティとそれぞれの重みを一覧にします。決定にはグループのしきい値に達する重みが必要です。"

msgid "A query can have only one “in” clause."
msgstr "クエリに指定できる「in」条件は 1 つだけです。"

msgid "A range (<, ≤, >, ≥, starts with) on “{field}” must be on the last property you filter on in index {index}, but “{other}” comes after it."
msgstr "「{field}」の範囲条件（<、≤、>、≥、で始まる）は、インデックス {index} で絞り込む最後のプロパティに指定する必要がありますが、「{other}」がその後にあります。"

