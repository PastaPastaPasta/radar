#. placeholder {0}: stats.missing
msgid "{0, plural, one {# masternode is not on the map: no address registered, or not crawled yet.} other {# masternodes are not on the map: no address registered, or not crawled yet.}}"
msgstr "{0, plural, other {マスターノード #件はマップに表示されていません。アドレスが未登録か、まだクロールされていません。}}"

#. placeholder {0}: totals.unlocated
msgid "{0, plural, one {# reachable node on Tor or I2P has no location, so it is not drawn.} other {# reachable nodes on Tor or I2P have no location, so they are not drawn.}}"
msgstr "{0, plural, other {Tor または I2P 上の到達可能なノード #件は位置情報がないため、描画されません。}}"

#. placeholder {0}: formatInt(Math.max(0, tip - c.last_paid_height))
msgid "{0} blocks ago"
msgstr "{0} ブロック前"

#. placeholder {0}: nodeCount(totals.nodes)
#. placeholder {1}: formatInt(totals.places)
#. placeholder {2}: formatInt(totals.masternodes)
msgid "{0} in {1} places; {2} are masternodes."
msgstr "{1} か所に {0}。うち {2} はマスターノードです。"

#. placeholder {0}: formatInt(places.size)
msgid "{0} places nearby"
msgstr "近くの {0} か所"

#. placeholder {0}: formatInt(nodes)
#. placeholder {1}: formatInt(masternodes)
#. placeholder {2}: formatInt(nodes - masternodes)
msgid "{0} reachable nodes: {1} masternodes and {2} other full nodes."
msgstr "{0} 個の到達可能なノード：マスターノード {1}、その他のフルノード {2}。"

#. placeholder {0}: chosen.length
msgid "{0} selected"
msgstr "{0} を選択中"

#. placeholder {0}: nodeCount(nodes)
#. placeholder {1}: formatInt(masternodes)
msgid "{0}, {1} of them masternodes"
msgstr "{0}（うちマスターノード {1}）"

#. placeholder {0}: mnCount(rows.length)
#. placeholder {1}: formatInt(reachable)
msgid "{0}, {1} reachable."
msgstr "{0}（到達可能 {1}）。"

#. placeholder {0}: mnCount(total)
msgid "{0}: {list}"
msgstr "{0}：{list}"

msgid "{answered} of {total} answered the latest crawl: {enabledAnswered} of {enabled} enabled and {bannedAnswered} of {banned} PoSe-banned."
msgstr "直近のクロールでは {total} 件中 {answered} 件が応答しました（有効 {enabled} 件中 {enabledAnswered} 件、PoSe で停止 {banned} 件中 {bannedAnswered} 件）。"

msgid "{answered} of {total} answered the latest crawl."
msgstr "直近のクロールでは {total} 件中 {answered} 件が応答しました。"

#. placeholder {0}: value(c.old)
msgid "{label} (was at {0})"
msgstr "{label}（以前は {0}）"

#. placeholder {0}: value(c.new)
msgid "{label} at {0}"
msgstr "{label}（{0}）"

msgid "{n, plural, one {# masternode} other {# masternodes}}"
msgstr "{n, plural, other {マスターノード #件}}"

msgid "{n, plural, one {# reachable node} other {# reachable nodes}}"
msgstr "{n, plural, other {到達可能なノード #件}}"

msgid "← Back to the list"
msgstr "← リストに戻る"

msgid "200 while every network's data is fresh and saved, 503 with what is wrong otherwise. For uptime checks."
msgstr "すべてのネットワークのデータが新しく保存されている間は 200、そうでなければ問題点を添えた 503 を返します。稼働監視用です。"

msgid "A summary of the speed tests from each vantage point."
msgstr "各観測拠点からの速度テストの要約です。"

msgid "A time series of one distribution. days is 1, 7, 14, 30, 90 or 365; top is 1 to 20; dim=totals returns the node counts instead."
msgstr "1 つの分布の時系列です。days は 1、7、14、30、90、365 のいずれか、top は 1〜20 です。dim=totals ではノード数を返します。"

msgid "Address"
msgstr "アドレス"

msgid "Address changes"
msgstr "アドレスの変更"

msgid "Addresses of nodes that aren't masternodes are never published, only counted."
msgstr "マスターノード以外のノードのアドレスは公開されず、数だけが集計されます。"

msgid "All nodes"
msgstr "すべてのノード"

msgid "All nodes (soon)"
msgstr "すべてのノード（近日対応）"

msgid "Any country"
msgstr "すべての国"

msgid "Any DKG readiness"
msgstr "すべての DKG 準備状況"

