msgstr "ビルド"

msgid "Call"
msgstr "呼び出し"

msgid "Cancel"
msgstr "キャンセル"

msgid "Chain"
msgstr "チェーン"

msgid "Change the source or the failures filter."
msgstr "ソースまたは失敗フィルターを変更してください。"

msgid "Clear"
msgstr "クリア"

msgid "Clear shown"
msgstr "表示中をクリア"

msgid "Clear the SDK cache"
msgstr "SDK キャッシュをクリア"

msgid "Clear viewed identities"
msgstr "閲覧したアイデンティティをクリア"

