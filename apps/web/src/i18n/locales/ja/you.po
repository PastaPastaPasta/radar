msgid "{count, plural, one {# DAPI address} other {# DAPI addresses}}"
msgstr "{count, plural, other {DAPI アドレス #件}}"

msgid "Add a devnet"
msgstr "devnet を追加"

msgid "Add devnet"
msgstr "devnet を追加"

msgid "Amounts"
msgstr "金額"

msgid "Amounts show in {unitName}."
msgstr "金額は {unitName} で表示されます。"

msgid "Amounts show in {unitName}. Choose USD to lead with the dollar value."
msgstr "金額は {unitName} で表示されます。USD を選ぶと、ドルの金額が先頭に表示されます。"

msgid "Cancel"
msgstr "キャンセル"

msgid "Custom devnets"
msgstr "カスタム devnet"

msgid "DAPI addresses"
msgstr "DAPI アドレス"

msgid "Devnet name"
msgstr "devnet 名"

msgid "Edit"
msgstr "編集"

msgid "Edit {editName}"
msgstr "{editName} を編集"

msgid "Enter at least one DAPI address as host:port, one per line."
msgstr "DAPI アドレスを host:port 形式で1行に1つ、少なくとも1つ入力してください。"

msgid "Example"
msgstr "例"

msgid "Language"
msgstr "言語"

msgid "No devnets saved."
msgstr "保存された devnet はありません。"

msgid "Open"
msgstr "開く"

msgid "optional"
msgstr "任意"

msgid "Otherwise times follow this device’s time zone. Hovering a time always shows UTC."
msgstr "オフの場合、時刻はこの端末のタイムゾーンに従います。時刻にカーソルを合わせると常に UTC が表示されます。"

msgid "Quorum list URL"
msgstr "クォーラム一覧の URL"

#. placeholder {0}: formatFiat(DUFFS_PER_DASH, rate.data.data.usd)
#. placeholder {1}: rate.data.data.provider
msgid "Rate: {0} per DASH, from {1}."
msgstr "レート: 1 DASH あたり {0}（{1}）。"

msgid "Remove"
msgstr "削除"

msgid "Remove {devnet}"
msgstr "{devnet} を削除"

msgid "Save changes"
msgstr "変更を保存"

msgid "Saved devnets"
msgstr "保存済みの devnet"

msgid "Saved in this browser. A devnet with a name Radar doesn’t know asks for its addresses."
msgstr "このブラウザに保存されます。Radar が知らない名前の devnet では、そのアドレスの入力が求められます。"

msgid "See every source"
msgstr "すべてのソースを見る"

msgid "Settings"
msgstr "設定"

msgid "Show the USD value next to DASH amounts"
msgstr "DASH の金額の横に USD 換算額を表示"

msgid "Show times in UTC"
msgstr "時刻を UTC で表示"

msgid "Sources"
msgstr "ソース"

msgid "Test coins have no value, so Testnet and devnets never show USD."
msgstr "テストコインに価値はないため、テストネットと devnet では USD は表示されません。"

msgid "Text that isn’t translated yet appears in English. Hashes, IDs and amounts are never translated."
msgstr "まだ翻訳されていないテキストは英語で表示されます。ハッシュ、ID、金額は翻訳されません。"

msgid "The quorum list URL must start with https://."
msgstr "クォーラム一覧の URL は https:// で始まる必要があります。"

msgid "These choices stay in this browser. Radar never sends them anywhere."
msgstr "これらの設定はこのブラウザ内に保存されます。Radar がどこかへ送信することはありません。"

msgid "Times"
msgstr "時刻"

msgid "Unit for amounts"
msgstr "金額の単位"

msgid "USD comes first, with the DASH figure after it once the rate is in."
msgstr "USD が先頭になり、レートが取得できると、その後ろに DASH の金額が表示されます。"

msgid "USD is for mainnet only: test coins have no value."
msgstr "USD はメインネット専用です。テストコインに価値はありません。"

msgid "USD is rounded to three significant figures and follows the amount in {unitName}."
msgstr "USD は有効数字3桁に丸められ、{unitName} の金額に連動します。"

msgid "USD is rounded to three significant figures. This choice doesn’t apply while USD comes first."
msgstr "USD は有効数字3桁に丸められます。USD が先頭のときは、この選択は適用されません。"

msgid "Use lowercase letters, digits and hyphens, for example \"ruby\"."
msgstr "小文字、数字、ハイフンを使用してください（例：「ruby」）。"

msgid "You"
msgstr "あなた"
