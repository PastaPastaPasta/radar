{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "radar-web",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../../apps/web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/assets/*"],
  },
  "routes": [{ "pattern": "explorer.dashhq.org", "custom_domain": true }],
  "observability": { "enabled": true, "head_sampling_rate": 0.25 },
  "env": {
    "preview": {
      "name": "radar-web-preview",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "explorer-next.dashhq.org", "custom_domain": true }],
      "observability": { "enabled": true, "head_sampling_rate": 1 },
    },
  },
}
