{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "radar-web",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../../apps/web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/assets/*"],
  },
  "vars": {
    "NATIVE_HOSTS": "explorer.dashhq.org",
  },
  "observability": { "enabled": false },
}
